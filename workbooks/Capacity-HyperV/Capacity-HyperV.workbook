{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "sub-param-001",
            "version": "KqlParameterItem/1.0",
            "name": "Subscriptions",
            "type": 6,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "includeAll": true,
              "showDefault": false
            },
            "defaultValue": "value::all",
            "value": [
              "value::all"
            ]
          },
          {
            "id": "node-trends-time-range",
            "version": "KqlParameterItem/1.0",
            "name": "NodeTrendsTimeRange",
            "label": "Historic Data Time Range",
            "type": 4,
            "isRequired": true,
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2592000000
                },
                {
                  "durationMs": 5184000000
                },
                {
                  "durationMs": 7776000000
                },
                {
                  "durationMs": 15552000000
                },
                {
                  "durationMs": 31536000000
                }
              ],
              "allowCustom": true
            },
            "value": {
              "durationMs": 2592000000
            }
          },
          {
            "id": "rg-filter-001",
            "version": "KqlParameterItem/1.0",
            "name": "ResourceGroupFilter",
            "type": 1,
            "description": "Optional: Filter by resource group name using wildcards. Example: *-prod-* or *hci*",
            "value": "",
            "label": "Resource Group Filter"
          },
          {
            "id": "tag-filter-001",
            "version": "KqlParameterItem/1.0",
            "name": "ClusterTagName",
            "type": 2,
            "description": "Optional: Filter Azure Local clusters by tag name. Select from dropdown or type custom value.",
            "query": "resources\r\n| where type == \"microsoft.azurestackhci/clusters\"\r\n| project tags\r\n| mv-expand bagexpansion=array tags\r\n| extend tagName = tostring(tags[0])\r\n| where isnotempty(tagName)\r\n| distinct tagName\r\n| order by tagName asc",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources",
            "value": null,
            "label": "Cluster Tag Name"
          },
          {
            "id": "tag-value-001",
            "version": "KqlParameterItem/1.0",
            "name": "ClusterTagValue",
            "type": 2,
            "description": "Optional: Filter Azure Local clusters by tag value. Select from dropdown or type custom value.",
            "query": "resources\r\n| where type == \"microsoft.azurestackhci/clusters\"\r\n| where '{ClusterTagName}' != ''\r\n| extend tagValue = tostring(tags['{ClusterTagName}'])\r\n| where isnotempty(tagValue)\r\n| distinct tagValue\r\n| order by tagValue asc",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources",
            "value": null,
            "label": "Cluster Tag Value"
          },
          {
            "id": "time-range-001",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "type": 4,
            "isRequired": true,
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 259200000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2592000000
                },
                {
                  "durationMs": 3888000000
                },
                {
                  "durationMs": 5184000000
                }
              ],
              "allowCustom": true
            },
            "value": {
              "durationMs": 3888000000
            },
            "label": "Time Range"
          },
          {
            "id": "cluster-rg-map-param",
            "version": "KqlParameterItem/1.0",
            "name": "ClusterRGMap",
            "type": 1,
            "description": "Hidden: maps resource group to cluster name for HCI clusters",
            "query": "resources\r\n| where type == \"microsoft.azurestackhci/clusters\"\r\n| where '{ResourceGroupFilter}' == '' or resourceGroup matches regex strcat('(?i)', replace_string(replace_string('{ResourceGroupFilter}', '*', '.*'), '?', '.'))\r\n| where '{ClusterTagName}' == '' or ('{ClusterTagValue}' != '' and tostring(tags['{ClusterTagName}']) =~ '{ClusterTagValue}')\r\n| project value = strcat(tolower(resourceGroup), ':', name)\r\n| summarize result = make_list(value)\r\n| project value = tostring(result)",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "isHiddenWhenLocked": true,
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          },
          {
            "id": "cluster-node-map-param",
            "version": "KqlParameterItem/1.0",
            "name": "ClusterNodeMap",
            "type": 1,
            "description": "Hidden: authoritative node-to-cluster map from microsoft.azurestackhci/clusters reportedProperties.nodes (format: nodeShort:clusterName:armId per entry). nodeShort is the lowercased NetBIOS hostname (FQDN suffix stripped) so it matches tolower(split(Computer, '.')[0]) emitted by Heartbeat / Perf. Used to constrain cluster-level aggregations to true cluster member nodes (excludes guest VMs that share the cluster resource group).",
            "query": "resources\r\n| where type == \"microsoft.azurestackhci/clusters\"\r\n| where '{ResourceGroupFilter}' == '' or resourceGroup matches regex strcat('(?i)', replace_string(replace_string('{ResourceGroupFilter}', '*', '.*'), '?', '.'))\r\n| where '{ClusterTagName}' == '' or ('{ClusterTagValue}' != '' and tostring(tags['{ClusterTagName}']) =~ '{ClusterTagValue}')\r\n| extend nodes = todynamic(properties.reportedProperties.nodes)\r\n| mv-expand node = nodes\r\n| extend nodeShort = tolower(tostring(split(tostring(node.name), '.')[0]))\r\n| where isnotempty(nodeShort)\r\n| project value = strcat(nodeShort, ':', name, ':', tostring(id))\r\n| summarize result = make_list(value)\r\n| project value = tostring(result)",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "isHiddenWhenLocked": true,
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          },
          {
            "id": "arc-machine-map-param",
            "version": "KqlParameterItem/1.0",
            "name": "ArcMachineMap",
            "type": 1,
            "description": "Hidden: maps Hyper-V guest VM short names to their Arc-enabled-server resource (microsoft.hybridcompute/machines). Format: vmShort:armId per entry. Used by the Hyper-V VM Inventory table to make the VM Name cell link to its Azure Local VM / AVD / Arc-onboarded VM control-plane resource when one exists. Filtered to detectedProperties.model =~ 'Virtual Machine' to bound parameter size to actual guest VMs (excludes physical hosts).",
            "query": "resources\r\n| where type =~ \"microsoft.hybridcompute/machines\"\r\n| where tostring(properties.detectedProperties.model) =~ 'Virtual Machine'\r\n| extend vmShort = tolower(tostring(split(name, '.')[0]))\r\n| where isnotempty(vmShort)\r\n| project value = strcat(vmShort, ':', tostring(id))\r\n| summarize result = make_list(value)\r\n| project value = tostring(result)",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "isHiddenWhenLocked": true,
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "global-subscription-param"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "crossComponentResources": [
          "{Subscriptions}"
        ],
        "parameters": [
          {
            "id": "cap-section-driver",
            "version": "KqlParameterItem/1.0",
            "name": "CapacitySection",
            "type": 1,
            "isHiddenWhenLocked": true,
            "typeSettings": {
              "additionalResourceOptions": []
            },
            "value": "overview"
          }
        ],
        "style": "pills",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources"
      },
      "name": "cap-shared-params"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 🖥️ Hyper-V VMs\r\n**Actionable data:** Identify the busiest hypervisor-visible VMs and virtual disks by CPU, memory pressure, storage, and network activity. The inventory and charts use Hyper-V counters in Log Analytics and include VMs that are not onboarded to Azure Arc.\r\n\r\nPerformance data does not provide VM operating system, resource group, or reliable power state. Use **Azure Local VMs** for Arc-enabled inventory details. If telemetry is missing, expand **Show Hyper-V DCR Setup Guide** below."
            },
            "name": "text-hyperv-header"
          },
          {
            "type": 1,
            "content": {
              "json": "---\r\n## 🔔 Hyper-V Telemetry Readiness\r\nThe charts require Azure Monitor Agent (AMA) and the 14 Hyper-V counter paths included in the all-in-one LENS Capacity DCR. Expand **Show Hyper-V DCR Setup Guide** for readiness checks and maintained deployment links."
            },
            "name": "text-hyperv-dcr-setup-header"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "hyperv-dcr-setup-toggle",
                  "version": "KqlParameterItem/1.0",
                  "name": "ShowHyperVDCRSetupSection",
                  "label": "Show Hyper-V DCR Setup Guide",
                  "type": 10,
                  "isRequired": true,
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[{\"value\": \"yes\", \"label\": \"Yes - Show DCR Setup\"}, {\"value\": \"no\", \"label\": \"No - Hide DCR Setup\"}]",
                  "value": "no"
                }
              ],
              "style": "pills",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "name": "hyperv-dcr-setup-toggle-param"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 1,
                  "content": {
                    "json": "### Hyper-V telemetry checklist and steps\r\n\r\n1. Install **Azure Monitor Agent (AMA)** on every node; select its Log Analytics workspace above.\r\n2. Use the **LENS Capacity DCR** with all **14 Hyper-V counter paths**, sent to `Perf` every 60 seconds.\r\n3. Create it in the workspace region and associate every physical machine, excluding guests.\r\n4. Verify the Hyper-V counters in `Perf`. Missing rows indicate a path, association, agent, or propagation issue.\r\n\r\n> ⚠️ **Do not associate another DCR collecting the same Hyper-V paths into this workspace.** AMA does not deduplicate them, causing duplicate rows and ingestion cost.\r\n\r\n### Knowledge links and instructions\r\n\r\n#### 1. [📘 LENS DCR Setup and Deployment Guide](https://github.com/Azure/AzureLocal-LENS-Workbook/blob/main/example-dcr-template/README.md)\r\n\r\n#### 2. [📄 LENS Capacity DCR Template](https://github.com/Azure/AzureLocal-LENS-Workbook/blob/main/example-dcr-template/dcr-azurelocal-capacity-perf.json)\r\n\r\n#### 3. [🔗 DCR Associations](https://learn.microsoft.com/azure/azure-monitor/data-collection/data-collection-rule-associations)\r\n\r\n#### 4. [🖥️ Hyper-V Performance Tuning](https://learn.microsoft.com/windows-server/administration/performance-tuning/role/hyper-v-server/)",
                    "style": "warning"
                  },
                  "name": "hyperv-dcr-readiness"
                }
              ]
            },
            "conditionalVisibility": {
              "parameterName": "ShowHyperVDCRSetupSection",
              "comparison": "isEqualTo",
              "value": "yes"
            },
            "name": "hyperv-dcr-setup-group"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "parameters": [
                {
                  "id": "hyperv-la-workspace",
                  "version": "KqlParameterItem/1.0",
                  "name": "HyperVLogAnalyticsWorkspace",
                  "label": "Log Analytics Workspace",
                  "type": 2,
                  "description": "Select one or more Log Analytics workspaces that receive Hyper-V performance counters from your Azure Local nodes. Choose **All** to query every workspace in the selected subscriptions; if queries fail, narrow the selection to accessible workspaces that receive Hyper-V counters.",
                  "isRequired": true,
                  "multiSelect": true,
                  "quote": "'",
                  "delimiter": ",",
                  "includeAll": true,
                  "defaultValue": "value::all",
                  "query": "resources\r\n| where type == \"microsoft.operationalinsights/workspaces\"\r\n| where '{ResourceGroupFilter}' == '' or resourceGroup matches regex strcat('(?i)', replace_string(replace_string('{ResourceGroupFilter}', '*', '.*'), '?', '.'))\r\n| project value = id, label = name\r\n| order by label asc",
                  "crossComponentResources": [
                    "{Subscriptions}"
                  ],
                  "typeSettings": {
                    "additionalResourceOptions": [
                      "value::all"
                    ],
                    "showDefault": false
                  },
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources"
                },
                {
                  "id": "hyperv-time-range",
                  "version": "KqlParameterItem/1.0",
                  "name": "HyperVTrendsTimeRange",
                  "label": "Historic Time Range",
                  "type": 4,
                  "description": "Time range for the Top VM / VHD performance charts below.",
                  "isRequired": true,
                  "typeSettings": {
                    "selectableValues": [
                      {
                        "durationMs": 3600000
                      },
                      {
                        "durationMs": 14400000
                      },
                      {
                        "durationMs": 43200000
                      },
                      {
                        "durationMs": 86400000
                      },
                      {
                        "durationMs": 259200000
                      },
                      {
                        "durationMs": 604800000
                      },
                      {
                        "durationMs": 1209600000
                      },
                      {
                        "durationMs": 2592000000
                      }
                    ],
                    "allowCustom": true
                  },
                  "value": {
                    "durationMs": 259200000
                  }
                }
              ],
              "style": "pills",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources"
            },
            "name": "hyperv-perf-params"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "hyperv-node-capacity-map",
                  "version": "KqlParameterItem/1.0",
                  "name": "HyperVNodeCapacityMap",
                  "type": 1,
                  "isHiddenWhenLocked": true,
                  "query": "resources\r\n| where type =~ 'microsoft.hybridcompute/machines'\r\n| where properties.cloudMetadata.provider =~ 'AzSHCI' and kind !~ 'HCI'\r\n| where '{ResourceGroupFilter}' == '' or resourceGroup matches regex strcat('(?i)', replace_string(replace_string('{ResourceGroupFilter}', '*', '.*'), '?', '.'))\r\n| extend matchKey = tolower(strcat(subscriptionId, '/', resourceGroup, '/', name))\r\n| project hostId = tolower(id), machine = name, matchKey, logicalProcessors = toint(properties.detectedProperties.logicalCoreCount), arcMemoryGiB = todouble(properties.detectedProperties.totalPhysicalMemoryInGigabytes)\r\n| join kind=leftouter (\r\n    resources\r\n    | where type =~ 'microsoft.azurestackhci/clusters'\r\n    | where '{ClusterTagName}' == '' or ('{ClusterTagValue}' != '' and tostring(tags['{ClusterTagName}']) =~ '{ClusterTagValue}')\r\n    | mv-expand node = properties.reportedProperties.nodes limit 2000\r\n    | extend matchKey = tolower(strcat(subscriptionId, '/', resourceGroup, '/', tostring(split(tostring(node.name), '.')[0])))\r\n    | project matchKey, cluster = name, clusterId = id, physicalCores = toint(node.coreCount), nodeMemoryGiB = todouble(node.memoryInGiB)\r\n) on matchKey\r\n| where '{ClusterTagName}' == '' or isnotempty(clusterId)\r\n| extend memoryGiB = iff(nodeMemoryGiB > 0, nodeMemoryGiB, arcMemoryGiB)\r\n| summarize mappings = make_list(bag_pack('hostId', hostId, 'machine', machine, 'cluster', cluster, 'clusterId', clusterId, 'physicalCores', physicalCores, 'logicalProcessors', logicalProcessors, 'memoryGiB', memoryGiB))\r\n| project value = tostring(mappings)",
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources",
                  "crossComponentResources": [
                    "{Subscriptions}"
                  ]
                }
              ],
              "style": "pills",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources"
            },
            "name": "hyperv-node-capacity-params"
          },
          {
            "type": 1,
            "content": {
              "json": "> **Scope:** Node Capacity uses Arc machine inventory and cluster metadata from the selected subscriptions, Resource Group, and Cluster Tag filters. Metrics come from the selected Log Analytics workspaces; nodes without matching telemetry remain visible as unavailable. VM inventory, tiles, and trends use workspace telemetry rather than global cluster filters. Physical Host scopes both tables; VM Name and Activity apply only to VM inventory.",
              "style": "info"
            },
            "name": "hyperv-global-filters-note"
          },
          {
            "type": 1,
            "content": {
              "json": "### 📊 Active VMs (from Log Analytics)"
            },
            "name": "hyperv-inventory-divider"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Perf\r\n| where ObjectName == \"Hyper-V Hypervisor Virtual Processor\"\r\n| where CounterName == \"% Guest Run Time\"\r\n| extend VMName = tostring(split(InstanceName, \":\")[0])\r\n| where isnotempty(VMName)\r\n| summarize by VMName\r\n| summarize Count = count()\r\n| extend Label = 'Active VMs (Hypervisor)'",
              "size": 3,
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "HyperVTrendsTimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{HyperVLogAnalyticsWorkspace}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Label",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "Count",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": false
              },
              "noDataMessage": "No active Hyper-V VMs found. Confirm AMA + a DCR with Hyper-V performance counters is configured on the nodes.",
              "noDataMessageStyle": 4
            },
            "name": "hyperv-tile-active-vms",
            "customWidth": "33"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Perf\r\n| where ObjectName == \"Hyper-V Hypervisor Virtual Processor\"\r\n| where CounterName == \"% Guest Run Time\"\r\n| extend VMName = tostring(split(InstanceName, \":\")[0])\r\n| where isnotempty(VMName)\r\n| summarize by Computer\r\n| summarize Count = count()\r\n| extend Label = 'Reporting Hosts'",
              "size": 3,
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "HyperVTrendsTimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{HyperVLogAnalyticsWorkspace}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Label",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "Count",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "purple"
                  }
                },
                "showBorder": false
              },
              "noDataMessage": "No Hyper-V hosts found in the selected workspace(s). Confirm AMA + a DCR with Hyper-V performance counters is configured on the nodes.",
              "noDataMessageStyle": 4
            },
            "name": "hyperv-tile-hosts",
            "customWidth": "33"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Perf\r\n| where ObjectName == \"Hyper-V Hypervisor Virtual Processor\"\r\n| where CounterName == \"% Guest Run Time\"\r\n| extend VMName = tostring(split(InstanceName, \":\")[0])\r\n| where isnotempty(VMName) and VMName != \"_Total\"\r\n| summarize HostCount = dcount(Computer) by VMName\r\n| summarize Count = countif(HostCount > 1)\r\n| extend Label = 'Live Migrated VMs', Subtitle = 'VMs seen on more than one host in window'",
              "size": 3,
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "HyperVTrendsTimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{HyperVLogAnalyticsWorkspace}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Label",
                  "formatter": 1
                },
                "subtitleContent": {
                  "columnMatch": "Subtitle",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "Count",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "green"
                  }
                },
                "showBorder": false
              },
              "noDataMessage": "No live-migrated VMs detected in the window — every observed VM ran on a single host. (Confirm AMA + a DCR with Hyper-V performance counters is configured if all three tiles are 0.)",
              "noDataMessageStyle": 4
            },
            "name": "hyperv-tile-vm-host-pairs",
            "customWidth": "33"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "crossComponentResources": [
                "{HyperVLogAnalyticsWorkspace}"
              ],
              "parameters": [
                {
                  "id": "hyperv-inv-vm-filter",
                  "version": "KqlParameterItem/1.0",
                  "name": "HyperVInvVMFilter",
                  "label": "VM Name (contains)",
                  "type": 1,
                  "description": "Filter the inventory table to VM names containing this text. Leave blank for all VMs.",
                  "value": ""
                },
                {
                  "id": "hyperv-inv-host-filter",
                  "version": "KqlParameterItem/1.0",
                  "name": "HyperVInvHostFilter",
                  "label": "Physical Host",
                  "type": 2,
                  "description": "Filter Node Capacity and VM inventory to physical Hyper-V hosts. All includes nodes without VM CPU telemetry.",
                  "multiSelect": true,
                  "quote": "'",
                  "delimiter": ",",
                  "query": "Perf\r\n| where ObjectName == \"Hyper-V Hypervisor Virtual Processor\" and CounterName == \"% Guest Run Time\"\r\n| summarize by Computer\r\n| order by Computer asc",
                  "typeSettings": {
                    "additionalResourceOptions": [
                      "value::all"
                    ],
                    "showDefault": false
                  },
                  "defaultValue": "value::all",
                  "queryType": 0,
                  "resourceType": "microsoft.operationalinsights/workspaces",
                  "crossComponentResources": [
                    "{HyperVLogAnalyticsWorkspace}"
                  ],
                  "timeContext": {
                    "durationMs": 0
                  },
                  "timeContextFromParameter": "HyperVTrendsTimeRange"
                },
                {
                  "id": "hyperv-inv-activity-filter",
                  "version": "KqlParameterItem/1.0",
                  "name": "HyperVInvActivity",
                  "label": "Activity",
                  "type": 2,
                  "description": "Filter VMs by how recently they emitted Hyper-V performance counters relative to the end of the selected time range.",
                  "isRequired": true,
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[{\"value\":\"all\",\"label\":\"All VMs in window\",\"selected\":true},{\"value\":\"recent\",\"label\":\"Currently active (last 15 min)\"},{\"value\":\"hour\",\"label\":\"Active in last hour\"},{\"value\":\"stale\",\"label\":\"Stale (>1 hour since last sample)\"}]",
                  "value": "all"
                }
              ],
              "style": "pills",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "name": "hyperv-inv-filters"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "hyperv-node-ratio-filter",
                  "version": "KqlParameterItem/1.0",
                  "name": "HyperVNodeRatioFilter",
                  "label": "V:P Ratio",
                  "type": 2,
                  "description": "Show nodes at or above the selected observed vCPU to physical core ratio. All also includes unavailable ratios.",
                  "isRequired": true,
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[{\"value\":\"0\",\"label\":\"All\"},{\"value\":\"1\",\"label\":\"\u2265 1:1\"},{\"value\":\"2\",\"label\":\"\u2265 2:1\"},{\"value\":\"3\",\"label\":\"\u2265 3:1\"},{\"value\":\"4\",\"label\":\"\u2265 4:1\"},{\"value\":\"5\",\"label\":\"\u2265 5:1\"},{\"value\":\"6\",\"label\":\"\u2265 6:1\"}]",
                  "value": "0"
                }
              ],
              "style": "pills",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "name": "hyperv-node-ratio-params"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let snapshotEnd = now() - 2m;\r\nlet windowStart = snapshotEnd - 15m;\r\nlet hosts = dynamic([{HyperVInvHostFilter}]);\r\nlet minimumRatio = todouble('{HyperVNodeRatioFilter}');\r\nlet nodeMap = materialize(print mapping = dynamic({HyperVNodeCapacityMap})\r\n    | mv-expand mapping\r\n    | extend HostId = tolower(tostring(mapping.hostId))\r\n    | summarize MappingCount = count(), Metadata = take_any(mapping) by HostId\r\n    | project HostId, Machine = tostring(Metadata.machine), Cluster = iff(MappingCount == 1, tostring(Metadata.cluster), ''), ClusterId = iff(MappingCount == 1, tostring(Metadata.clusterId), ''), PhysicalCores = iff(MappingCount == 1, toint(Metadata.physicalCores), int(null)), LogicalProcessors = toint(Metadata.logicalProcessors), TotalMemoryGiB = iff(MappingCount == 1, todouble(Metadata.memoryGiB), real(null)), MappingCount);\r\nlet raw = materialize(Perf\r\n    | where TimeGenerated between (windowStart .. snapshotEnd)\r\n    | where (ObjectName == 'Hyper-V Hypervisor Virtual Processor' and CounterName == '% Guest Run Time')\r\n        or (ObjectName == 'Processor' and CounterName == '% Processor Time' and InstanceName == '_Total')\r\n        or (ObjectName == 'Memory' and CounterName == 'Available Bytes')\r\n    | extend HostId = tolower(_ResourceId)\r\n    | where isnotempty(HostId));\r\nlet hostNames = raw | summarize arg_max(TimeGenerated, Computer) by HostId;\r\nlet snapshots = materialize(raw\r\n    | where ObjectName == 'Hyper-V Hypervisor Virtual Processor'\r\n    | extend VMName = extract('^(.*):Hv VP ([0-9]+)$', 1, InstanceName)\r\n    | summarize by HostId, TimeGenerated, InstanceName, VMName\r\n    | summarize VcpuSet = make_set_if(InstanceName, isnotempty(VMName) and VMName != '_Total'), VMNames = make_set_if(VMName, isnotempty(VMName) and VMName != '_Total'), AggregateCount = countif(InstanceName == '_Total'), UnknownCount = countif(isempty(VMName) and InstanceName != '_Total') by HostId, TimeGenerated);\r\nlet newest = snapshots | summarize arg_max(TimeGenerated, *) by HostId | project HostId, CpuSampleTime = TimeGenerated, VcpuSet, VMNames, AggregateCount, UnknownCount;\r\nlet previous = snapshots\r\n    | join kind=inner (newest | project HostId, CpuSampleTime) on HostId\r\n    | where TimeGenerated < CpuSampleTime\r\n    | summarize arg_max(TimeGenerated, *) by HostId\r\n    | project HostId, PreviousTime = TimeGenerated, PreviousSet = VcpuSet, PreviousAggregate = AggregateCount, PreviousUnknown = UnknownCount;\r\nlet collisions = newest\r\n    | join kind=inner nodeMap on HostId\r\n    | where isnotempty(ClusterId)\r\n    | mv-expand VMName = VMNames to typeof(string)\r\n    | summarize HostIds = make_set(HostId) by ClusterId, VMName\r\n    | where array_length(HostIds) > 1\r\n    | mv-expand HostId = HostIds to typeof(string)\r\n    | summarize ConflictingNames = count() by HostId;\r\nlet hostCpu = raw\r\n    | where ObjectName == 'Processor' and CounterValue between (0.0 .. 100.0)\r\n    | summarize SampleCpu = avg(CounterValue) by HostId, TimeGenerated\r\n    | summarize AvgCpu = avg(SampleCpu) by HostId;\r\nlet memory = raw\r\n    | where ObjectName == 'Memory'\r\n    | summarize FreeBytes = avg(CounterValue) by HostId, TimeGenerated\r\n    | summarize arg_max(TimeGenerated, FreeBytes) by HostId\r\n    | project HostId, MemorySampleTime = TimeGenerated, FreeMemoryGiB = FreeBytes / 1073741824.0;\r\nnodeMap\r\n| join kind=leftouter hostNames on HostId\r\n| where set_has_element(hosts, '*') or set_has_element(hosts, Computer) or set_has_element(hosts, Machine)\r\n| join kind=leftouter newest on HostId\r\n| join kind=leftouter previous on HostId\r\n| join kind=leftouter collisions on HostId\r\n| join kind=leftouter hostCpu on HostId\r\n| join kind=leftouter memory on HostId\r\n| extend CpuStatus = case(isnull(CpuSampleTime), 'Missing VM CPU telemetry', ConflictingNames > 0, 'VM name on multiple nodes', isnull(PreviousTime) or CpuSampleTime - PreviousTime > 2m or AggregateCount != 1 or PreviousAggregate != 1 or UnknownCount > 0 or PreviousUnknown > 0 or array_length(VcpuSet) == 0 or array_length(set_difference(VcpuSet, PreviousSet)) > 0 or array_length(set_difference(PreviousSet, VcpuSet)) > 0, 'Unconfirmed CPU snapshot', 'Observed')\r\n| extend ObservedVcpus = iff(CpuStatus == 'Observed', array_length(VcpuSet), long(null)), ValidMemory = TotalMemoryGiB > 0 and FreeMemoryGiB >= 0 and FreeMemoryGiB <= TotalMemoryGiB\r\n| extend Ratio = iff(PhysicalCores > 0 and MappingCount == 1, todouble(ObservedVcpus) / PhysicalCores, real(null)), UsedMemoryGiB = iff(ValidMemory, TotalMemoryGiB - FreeMemoryGiB, real(null))\r\n| where minimumRatio == 0 or Ratio >= minimumRatio\r\n| extend Status = strcat(CpuStatus, iff(MappingCount != 1, '; ambiguous cluster mapping', iff(isempty(ClusterId), '; cluster unresolved', '')), iff(isnull(PhysicalCores) or PhysicalCores <= 0, '; physical cores unavailable', ''), iff(isnull(AvgCpu), '; host CPU unavailable', ''), iff(coalesce(ValidMemory, false), '', '; memory unavailable'))\r\n| project Machine, Cluster, ['Physical CPU Cores'] = PhysicalCores, ['Logical Processors'] = LogicalProcessors, ['Observed VM vCPUs'] = ObservedVcpus, ['V:P CPU Ratio'] = round(Ratio, 2), ['Avg CPU % (15 min)'] = round(AvgCpu, 1), ['Avg CPU Free %'] = round(100.0 - AvgCpu, 1), ['Memory Used %'] = round(100.0 * UsedMemoryGiB / TotalMemoryGiB, 1), ['Memory Total GiB'] = round(TotalMemoryGiB, 1), ['Memory Used GiB'] = round(UsedMemoryGiB, 1), ['Memory Free / Available GiB'] = round(iff(ValidMemory, FreeMemoryGiB, real(null)), 1), Status, ['VM CPU Sample (UTC)'] = CpuSampleTime, ['Memory Sample (UTC)'] = MemorySampleTime, machineLink = strcat('https://portal.azure.com/#@/resource', HostId), clusterLink = iff(isempty(ClusterId), '', strcat('https://portal.azure.com/#@/resource', ClusterId))\r\n| order by ['V:P CPU Ratio'] desc nulls last, Machine asc",
              "size": 0,
              "title": "Node Capacity - CPU, Memory and VM Density",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{HyperVLogAnalyticsWorkspace}"
              ],
              "timeContext": {
                "durationMs": 3600000
              },
              "showAnalytics": true,
              "showExportToExcel": true,
              "visualization": "table",
              "noDataMessage": "No Arc-enabled Azure Local nodes match the selected scope, Physical Host, and minimum ratio. Select All for V:P Ratio to include unavailable ratios, then check the scope filters.",
              "noDataMessageStyle": 4,
              "gridSettings": {
                "rowLimit": 5000,
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "V:P CPU Ratio",
                    "sortOrder": 2
                  }
                ],
                "formatters": [
                  {
                    "columnMatch": "Machine",
                    "formatter": 7,
                    "formatOptions": {
                      "linkTarget": "Url",
                      "linkColumn": "machineLink"
                    }
                  },
                  {
                    "columnMatch": "Cluster",
                    "formatter": 7,
                    "formatOptions": {
                      "linkTarget": "Url",
                      "linkColumn": "clusterLink"
                    }
                  },
                  {
                    "columnMatch": "machineLink",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "clusterLink",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "Memory Used %",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": ">=",
                          "thresholdValue": "90",
                          "representation": "redBright",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": ">=",
                          "thresholdValue": "80",
                          "representation": "yellow",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "green",
                          "text": "{0}{1}"
                        }
                      ]
                    },
                    "numberFormat": {
                      "unit": 1,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 1
                      }
                    }
                  },
                  {
                    "columnMatch": "VM CPU Sample (UTC)",
                    "formatter": 6,
                    "dateFormat": {
                      "showUtcTime": true,
                      "formatName": "shortDateTimePattern"
                    }
                  },
                  {
                    "columnMatch": "Memory Sample (UTC)",
                    "formatter": 6,
                    "dateFormat": {
                      "showUtcTime": true,
                      "formatName": "shortDateTimePattern"
                    }
                  }
                ]
              },
              "sortBy": [
                {
                  "itemKey": "V:P CPU Ratio",
                  "sortOrder": 2
                }
              ]
            },
            "name": "hyperv-node-capacity"
          },
          {
            "type": 1,
            "content": {
              "json": "**Node capacity:** V:P compares observed guest vCPUs with physical CPU cores, not SMT threads. Blank values mean unavailable, not zero. Average CPU free is utilization headroom, not unallocated vCPUs. Memory used is physical total minus Available Bytes, not committed memory.\r\n\r\nThe table uses a 15-minute window ending two minutes ago, independent of Historic Time Range. Changing, aggregate-only, or conflicting VM-name snapshots remain unconfirmed. **[Calculations and limitations](https://github.com/Azure/AzureLocal-LENS-Workbook#hyper-v-node-capacity)**",
              "style": "info"
            },
            "name": "hyperv-node-capacity-help"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let vmFilter = tolower('{HyperVInvVMFilter}');\r\nlet activityMode = '{HyperVInvActivity}';\r\nlet hosts = dynamic([{HyperVInvHostFilter}]);\r\n// Two-tier cluster lookup:\r\n//  1. nodeMap   — authoritative per-host map from microsoft.azurestackhci/clusters reportedProperties.nodes (best, includes armId).\r\n//  2. clusterMap — RG-based fallback when a host is in a cluster RG but not yet listed in reportedProperties.nodes (e.g. recently re-imaged node, or the reported list lagging behind ARG).\r\n// armId is sourced from nodeMap.distinct(clusterName) so the portal link still works for tier-2 matches as long as ANY node of that cluster appears in reportedProperties.nodes.\r\nlet nodeMap = materialize(\r\n    print mapping = dynamic({ClusterNodeMap})\r\n    | mv-expand mapping to typeof(string)\r\n    | extend parts = split(mapping, ':')\r\n    | project nodeShort = tolower(tostring(parts[0])), clusterNameNode = tostring(parts[1]), armId = tostring(parts[2]));\r\nlet clusterMap = materialize(\r\n    print mapping = dynamic({ClusterRGMap})\r\n    | mv-expand mapping to typeof(string)\r\n    | extend parts = split(mapping, ':')\r\n    | project nodeRG = tolower(tostring(parts[0])), clusterNameRG = tostring(parts[1]));\r\nlet armIdByCluster = nodeMap | distinct clusterNameNode, armId | project clusterName = clusterNameNode, armId;\r\nlet hostRG = materialize(Heartbeat\r\n    | where OSType == \"Windows\"\r\n    | summarize arg_max(TimeGenerated, *) by Computer\r\n    | project hbComputer = Computer, nodeRG = tolower(ResourceGroup));\r\n// Arc-machine map (Hyper-V guest VMs) so the VM Name cell can link to its Azure Local VM / AVD / Arc-onboarded control-plane resource when one exists. Match is on the lowercased VM short name (parameter is pre-filtered to detectedProperties.model =~ 'Virtual Machine' to bound size).\r\nlet arcMap = materialize(\r\n    print mapping = dynamic({ArcMachineMap})\r\n    | mv-expand mapping to typeof(string)\r\n    | extend parts = split(mapping, ':')\r\n    | project vmShort = tolower(tostring(parts[0])), vmArmId = tostring(parts[1]));\r\nlet perfRaw = Perf\r\n    | where ObjectName == \"Hyper-V Hypervisor Virtual Processor\" and CounterName == \"% Guest Run Time\"\r\n    | where set_has_element(hosts, '*') or set_has_element(hosts, Computer)\r\n    | extend VMName = tostring(split(InstanceName, \":\")[0])\r\n    | extend vCpuId = tostring(split(InstanceName, \":\")[1])\r\n    | where isnotempty(VMName) and VMName != \"_Total\"\r\n    | where vmFilter == '' or VMName contains vmFilter;\r\nlet cpuStats = perfRaw\r\n    | where vCpuId != \"_Total\" and isnotempty(vCpuId)\r\n    | summarize VMcpu = avg(CounterValue) by VMName, bin(TimeGenerated, 1m)\r\n    | summarize ['Avg CPU %'] = round(avg(VMcpu), 1) by VMName;\r\nlet memStats = Perf\r\n    | where ObjectName == \"Hyper-V Dynamic Memory VM\" and CounterName == \"Current Pressure\"\r\n    | where InstanceName != \"_Total\" and isnotempty(InstanceName)\r\n    | summarize ['Avg Memory %'] = round(avg(CounterValue), 1) by VMName = InstanceName;\r\nperfRaw\r\n| summarize\r\n    ['First Seen (UTC)'] = min(TimeGenerated),\r\n    ['vCPUs (observed)'] = dcountif(vCpuId, vCpuId != \"_Total\" and isnotempty(vCpuId)),\r\n    arg_max(TimeGenerated, Computer)\r\n  by VMName\r\n| project-rename ['Last Seen (UTC)'] = TimeGenerated, ['Physical Host'] = Computer\r\n| join kind=leftouter cpuStats on VMName\r\n| project-away VMName1\r\n| join kind=leftouter memStats on VMName\r\n| project-away VMName1\r\n| extend nodeShort = tolower(tostring(split(['Physical Host'], '.')[0]))\r\n| join kind=leftouter nodeMap on nodeShort\r\n| join kind=leftouter hostRG on $left.['Physical Host'] == $right.hbComputer\r\n| join kind=leftouter clusterMap on nodeRG\r\n| extend ['Cluster Name'] = coalesce(clusterNameNode, clusterNameRG, '')\r\n| join kind=leftouter armIdByCluster on $left.['Cluster Name'] == $right.clusterName\r\n| extend clusterLink = iff(isempty(armId), '', strcat('https://portal.azure.com/#@/resource', armId))\r\n| extend vmShort = tolower(tostring(VMName))\r\n| join kind=leftouter arcMap on vmShort\r\n| extend vmLink = iff(isempty(vmArmId), '', strcat('https://portal.azure.com/#@/resource', vmArmId))\r\n| extend AgeMinutes = datetime_diff('minute', now(), ['Last Seen (UTC)'])\r\n| extend Activity = case(\r\n      AgeMinutes <= 15, \"\\u2705 Active (last 15 min)\",\r\n      AgeMinutes <= 60, \"\\ud83d\\udfe2 Active (last hour)\",\r\n      AgeMinutes <= 1440, \"\\ud83d\\udfe1 Idle (>1h)\",\r\n      \"\\ud83d\\udd34 Stale (>24h)\")\r\n| where activityMode == 'all'\r\n    or (activityMode == 'recent' and AgeMinutes <= 15)\r\n    or (activityMode == 'hour' and AgeMinutes <= 60)\r\n    or (activityMode == 'stale' and AgeMinutes > 60)\r\n| project ['VM Name'] = VMName, vmLink, Activity, ['Physical Host'], ['Cluster Name'], clusterLink, ['vCPUs (observed)'], ['Avg CPU %'], ['Avg Memory %'], ['First Seen (UTC)'], ['Last Seen (UTC)']\r\n| order by ['Avg CPU %'] desc nulls last",
              "size": 0,
              "showAnalytics": true,
              "showExportToExcel": true,
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "HyperVTrendsTimeRange",
              "title": "📋 Hyper-V VM Inventory (Perf-derived)",
              "noDataMessage": "No Hyper-V CPU telemetry matched the current filters, workspace, and time range. Open **Capacity > Overview > Show DCR Setup Guide** to verify the required counter is collected from every Azure Local node.",
              "noDataMessageStyle": 4,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{HyperVLogAnalyticsWorkspace}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "VM Name",
                    "formatter": 7,
                    "formatOptions": {
                      "linkTarget": "Url",
                      "linkColumn": "vmLink"
                    }
                  },
                  {
                    "columnMatch": "vmLink",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "Activity",
                    "formatter": 1
                  },
                  {
                    "columnMatch": "Physical Host",
                    "formatter": 1
                  },
                  {
                    "columnMatch": "Cluster Name",
                    "formatter": 7,
                    "formatOptions": {
                      "linkTarget": "Url",
                      "linkColumn": "clusterLink"
                    }
                  },
                  {
                    "columnMatch": "clusterLink",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "vCPUs (observed)",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "purple"
                    }
                  },
                  {
                    "columnMatch": "Avg CPU %",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "blue"
                    },
                    "numberFormat": {
                      "unit": 1,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 1
                      }
                    }
                  },
                  {
                    "columnMatch": "Avg Memory %",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": ">=",
                          "thresholdValue": "100",
                          "representation": "redBright",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": ">=",
                          "thresholdValue": "80",
                          "representation": "yellow",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "green",
                          "text": "{0}{1}"
                        }
                      ]
                    },
                    "numberFormat": {
                      "unit": 1,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 1
                      }
                    }
                  },
                  {
                    "columnMatch": "First Seen (UTC)",
                    "formatter": 6,
                    "dateFormat": {
                      "showUtcTime": true,
                      "formatName": "shortDateTimePattern"
                    }
                  },
                  {
                    "columnMatch": "Last Seen (UTC)",
                    "formatter": 6,
                    "dateFormat": {
                      "showUtcTime": true,
                      "formatName": "shortDateTimePattern"
                    }
                  }
                ],
                "rowLimit": 5000,
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "Avg CPU %",
                    "sortOrder": 2
                  }
                ]
              },
              "sortBy": [
                {
                  "itemKey": "Avg CPU %",
                  "sortOrder": 2
                }
              ]
            },
            "name": "hyperv-vm-inventory"
          },
          {
            "type": 1,
            "content": {
              "json": "💡 **Inventory notes:** This table represents VMs that emitted the Hyper-V CPU counter during the selected time range; stopped, paused, saved, or otherwise silent VMs do not appear. **VM Name** links to Azure when an Arc-enabled machine exists. AKS worker VMs normally remain unlinked; use **AKS Arc Clusters** for their control plane.\r\n\r\n**Physical Host** is the last reporting host, so a migrated VM appears once. **Cluster Name** uses Azure Local node membership, then the host resource group; a blank value means the host is standalone or outside the current scope. **vCPUs (observed)** counts reported vCPU instances. **Avg Memory %** is available only for Dynamic Memory VMs: below 80 is green, 80-99 yellow, and 100 or more red. First/last-seen values are UTC.",
              "style": "info"
            },
            "name": "hyperv-inv-help"
          },
          {
            "type": 1,
            "content": {
              "json": "---\r\n## 📈 Performance Trends"
            },
            "name": "hyperv-perf-divider"
          },
          {
            "type": 1,
            "content": {
              "json": "💡 **Tip:** These charts use Hyper-V counters in the selected workspace and time range. If telemetry is missing, open **Capacity > Overview > Show DCR Setup Guide**. Storage series represent individual virtual disks (VHD/VHDX), not whole VMs.",
              "style": "upsell"
            },
            "name": "hyperv-perf-tip"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let trendStart = {HyperVTrendsTimeRange:start};\r\nlet trendEnd = {HyperVTrendsTimeRange:end};\r\nlet step = iif(datetime_diff('hour', trendEnd, trendStart) <= 6, 5m, iif(datetime_diff('day', trendEnd, trendStart) <= 3, 30m, iif(datetime_diff('day', trendEnd, trendStart) <= 14, 2h, 1d)));\r\nlet perfData = Perf\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where ObjectName == \"Hyper-V Hypervisor Virtual Processor\" and CounterName == \"% Guest Run Time\"\r\n| where InstanceName !contains \"_Total\" and isnotempty(InstanceName)\r\n| extend seriesKey = tostring(split(InstanceName, \":\")[0])\r\n| where isnotempty(seriesKey) and seriesKey != \"_Total\"\r\n| project TimeGenerated, seriesKey, Value = CounterValue;\r\nlet top5 = perfData\r\n| summarize AvgValue = avg(Value) by seriesKey\r\n| top 5 by AvgValue desc\r\n| project seriesKey;\r\nperfData\r\n| lookup kind=inner top5 on seriesKey\r\n| summarize [\"Avg CPU %\"] = round(avg(Value), 2) by bin(TimeGenerated, step), seriesKey\r\n| order by TimeGenerated asc",
              "size": 1,
              "showAnalytics": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{HyperVLogAnalyticsWorkspace}"
              ],
              "aggregation": 3,
              "title": "📈 Top VMs by CPU Usage — % Guest Run Time (0-100% per vCPU)",
              "noDataMessage": "No Hyper-V CPU data. Ensure '\\Hyper-V Hypervisor Virtual Processor(*)\\% Guest Run Time' is in the DCR's counterSpecifiers and DCRAs exist on every node.",
              "visualization": "linechart",
              "chartSettings": {
                "xAxis": "TimeGenerated",
                "yAxis": [
                  "Avg CPU %"
                ],
                "group": "seriesKey",
                "showLegend": true,
                "ySettings": {
                  "min": 0,
                  "numberFormatSettings": {
                    "unit": 0,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 1
                    }
                  }
                },
                "seriesLabelSettings": []
              }
            },
            "name": "hyperv-chart-cpu",
            "customWidth": "50",
            "styleSettings": {
              "margin": "5px",
              "padding": "5px"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let trendStart = {HyperVTrendsTimeRange:start};\r\nlet trendEnd = {HyperVTrendsTimeRange:end};\r\nlet step = iif(datetime_diff('hour', trendEnd, trendStart) <= 6, 5m, iif(datetime_diff('day', trendEnd, trendStart) <= 3, 30m, iif(datetime_diff('day', trendEnd, trendStart) <= 14, 2h, 1d)));\r\nlet perfData = Perf\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where ObjectName == \"Hyper-V Dynamic Memory VM\" and CounterName == \"Current Pressure\"\r\n| where InstanceName !contains \"_Total\" and isnotempty(InstanceName)\r\n| extend seriesKey = InstanceName\r\n| where isnotempty(seriesKey) and seriesKey != \"_Total\"\r\n| project TimeGenerated, seriesKey, Value = CounterValue;\r\nlet top5 = perfData\r\n| summarize AvgValue = avg(Value) by seriesKey\r\n| top 5 by AvgValue desc\r\n| project seriesKey;\r\nperfData\r\n| lookup kind=inner top5 on seriesKey\r\n| summarize [\"Memory Pressure\"] = round(avg(Value), 2) by bin(TimeGenerated, step), seriesKey\r\n| order by TimeGenerated asc",
              "size": 1,
              "showAnalytics": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{HyperVLogAnalyticsWorkspace}"
              ],
              "aggregation": 3,
              "title": "📈 Top VMs by Memory Pressure (≤80 healthy · 100 = at limit · >100 under pressure)",
              "noDataMessage": "No Hyper-V memory pressure data. Memory Pressure is a Dynamic Memory metric — only VMs with Dynamic Memory enabled report it. Static-memory VMs (including AKS Arc workloads) will never appear here. If no VMs use Dynamic Memory this chart will always be empty by design.",
              "visualization": "linechart",
              "chartSettings": {
                "xAxis": "TimeGenerated",
                "yAxis": [
                  "Memory Pressure"
                ],
                "group": "seriesKey",
                "showLegend": true,
                "ySettings": {
                  "min": 0,
                  "numberFormatSettings": {
                    "unit": 0,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 1
                    }
                  }
                },
                "seriesLabelSettings": []
              }
            },
            "name": "hyperv-chart-mempressure",
            "customWidth": "50",
            "styleSettings": {
              "margin": "5px",
              "padding": "5px"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let trendStart = {HyperVTrendsTimeRange:start};\r\nlet trendEnd = {HyperVTrendsTimeRange:end};\r\nlet step = iif(datetime_diff('hour', trendEnd, trendStart) <= 6, 5m, iif(datetime_diff('day', trendEnd, trendStart) <= 3, 30m, iif(datetime_diff('day', trendEnd, trendStart) <= 14, 2h, 1d)));\r\nlet perfData = Perf\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where ObjectName == \"Hyper-V Virtual Storage Device\" and CounterName in (\"Read Bytes/sec\", \"Write Bytes/sec\")\r\n| where InstanceName !contains \"_Total\" and isnotempty(InstanceName)\r\n| extend vhdName = coalesce(extract(@'([^\\\\/]+\\.(?:vhdx?|avhdx?|vmgs|vmrs|iso))', 1, InstanceName), extract(@'-([^-]+\\.(?:vhdx?|avhdx?|vmgs|vmrs|iso))', 1, InstanceName), extract(@'-Virtual Machines-([^-]+)', 1, InstanceName), extract(@'([^\\\\/-]+)$', 1, InstanceName), InstanceName)\r\n| where isnotempty(vhdName)\r\n| summarize BytesPerSec = sum(CounterValue) by bin(TimeGenerated, step), vhdName\r\n| project TimeGenerated, vhdName, MBPerSec = BytesPerSec / 1048576.0;\r\nlet top5 = perfData\r\n| summarize AvgMBps = avg(MBPerSec) by vhdName\r\n| top 5 by AvgMBps desc\r\n| project vhdName;\r\nperfData\r\n| lookup kind=inner top5 on vhdName\r\n| summarize [\"Throughput (MB/s)\"] = round(avg(MBPerSec), 2) by TimeGenerated, vhdName\r\n| order by TimeGenerated asc",
              "size": 1,
              "showAnalytics": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{HyperVLogAnalyticsWorkspace}"
              ],
              "aggregation": 3,
              "title": "📈 Top Virtual Disks by Storage Throughput — Read+Write MB/s (per VHD/VHDX)",
              "noDataMessage": "No Hyper-V Virtual Storage Device throughput data. Ensure '\\Hyper-V Virtual Storage Device(*)\\Read Bytes/sec' and 'Write Bytes/sec' are in the DCR's counterSpecifiers.",
              "visualization": "linechart",
              "chartSettings": {
                "xAxis": "TimeGenerated",
                "yAxis": [
                  "Throughput (MB/s)"
                ],
                "group": "vhdName",
                "showLegend": true,
                "ySettings": {
                  "min": 0,
                  "numberFormatSettings": {
                    "unit": 0,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 2
                    }
                  }
                },
                "seriesLabelSettings": []
              }
            },
            "name": "hyperv-chart-storage-throughput",
            "customWidth": "50",
            "styleSettings": {
              "margin": "5px",
              "padding": "5px"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let trendStart = {HyperVTrendsTimeRange:start};\r\nlet trendEnd = {HyperVTrendsTimeRange:end};\r\nlet step = iif(datetime_diff('hour', trendEnd, trendStart) <= 6, 5m, iif(datetime_diff('day', trendEnd, trendStart) <= 3, 30m, iif(datetime_diff('day', trendEnd, trendStart) <= 14, 2h, 1d)));\r\nlet perfData = Perf\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where ObjectName == \"Hyper-V Virtual Storage Device\" and CounterName in (\"Read Operations/Sec\", \"Write Operations/Sec\")\r\n| where InstanceName !contains \"_Total\" and isnotempty(InstanceName)\r\n| extend vhdName = coalesce(extract(@'([^\\\\/]+\\.(?:vhdx?|avhdx?|vmgs|vmrs|iso))', 1, InstanceName), extract(@'-([^-]+\\.(?:vhdx?|avhdx?|vmgs|vmrs|iso))', 1, InstanceName), extract(@'-Virtual Machines-([^-]+)', 1, InstanceName), extract(@'([^\\\\/-]+)$', 1, InstanceName), InstanceName)\r\n| where isnotempty(vhdName)\r\n| summarize Iops = sum(CounterValue) by bin(TimeGenerated, step), vhdName;\r\nlet top5 = perfData\r\n| summarize AvgIops = avg(Iops) by vhdName\r\n| top 5 by AvgIops desc\r\n| project vhdName;\r\nperfData\r\n| lookup kind=inner top5 on vhdName\r\n| summarize [\"IOPS\"] = round(avg(Iops), 0) by TimeGenerated, vhdName\r\n| order by TimeGenerated asc",
              "size": 1,
              "showAnalytics": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{HyperVLogAnalyticsWorkspace}"
              ],
              "aggregation": 3,
              "title": "📈 Top Virtual Disks by Storage IOPS — Read+Write Operations/sec (per VHD/VHDX)",
              "noDataMessage": "No Hyper-V Virtual Storage Device IOPS data. Ensure '\\Hyper-V Virtual Storage Device(*)\\Read Operations/Sec' and 'Write Operations/Sec' are in the DCR's counterSpecifiers.",
              "visualization": "linechart",
              "chartSettings": {
                "xAxis": "TimeGenerated",
                "yAxis": [
