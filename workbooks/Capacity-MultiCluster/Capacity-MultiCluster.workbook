          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let trendStart = {NodeTrendsTimeRange:start};\nlet trendEnd = {NodeTrendsTimeRange:end};\nlet step = 1d;\nlet isAllClusters = \"{ChartClusterFilter}\" contains \"value::all\";\n// Build authoritative NodeToCluster mapping from ARG (Heartbeat + ClusterRGMap + ClusterNodeMap) — no SDDC dependency\nlet clusterMap = materialize(\n    print mapping = dynamic({ClusterRGMap})\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeRG = tolower(tostring(parts[0])), clusterName = tostring(parts[1]));\nlet nodeMap = materialize(\n    print mapping = dynamic({ClusterNodeMap})\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeShort = tolower(tostring(parts[0])), clusterName = tostring(parts[1]), armId = tostring(parts[2]));\nlet clustersWithNodeMap = nodeMap | distinct clusterName;\nlet armIdByCluster = nodeMap | distinct clusterName, armId;\nlet NodeToCluster = materialize(Heartbeat\n    | where TimeGenerated between (trendStart .. trendEnd)\n    | where OSType == \"Windows\"\n    | summarize arg_max(TimeGenerated, *) by Computer\n    | extend nodeName = tolower(Computer), nodeRG = tolower(ResourceGroup), nodeShort = tolower(tostring(split(Computer, '.')[0]))\n    | lookup kind=inner clusterMap on nodeRG\n    | extend hasNodeMap = clusterName in (clustersWithNodeMap)\n    | join kind=leftouter (nodeMap | project nodeShort, nmCluster=clusterName, armId) on nodeShort\n    | where hasNodeMap == false or nmCluster == clusterName\n    | join kind=leftouter armIdByCluster on clusterName\n    | extend ClusterArmId_s = coalesce(armId, armId1, \"\")\n    | where isAllClusters or ClusterArmId_s in~ ({ChartClusterFilter})\n    | project nodeName, clusterName);\nlet perfNetRaw = Perf\n| where TimeGenerated between (trendStart .. trendEnd)\n| where ObjectName in (\"Network Adapter\", \"Network Interface\") and CounterName == \"Bytes Total/sec\"\n| where InstanceName != \"_Total\"\n| extend nodeName = tolower(Computer)\n| extend netRank = iff(ObjectName == \"Network Interface\", 1, 2)\n| project TimeGenerated, nodeName, CounterValue, netRank;\nlet bestNetObject = perfNetRaw | summarize bestNetRank = min(netRank) by nodeName;\nlet perfNet = perfNetRaw\n| lookup kind=inner bestNetObject on nodeName\n| where netRank == bestNetRank\n| summarize BytesPerSec = sum(CounterValue) by nodeName, TimeGenerated = bin(TimeGenerated, 1m)\n| project TimeGenerated, nodeName, BytesPerSec, method = 1;\nlet insightsNet = InsightsMetrics\n| where TimeGenerated between (trendStart .. trendEnd)\n| where Namespace == \"Network\" and Name in (\"WriteBytesPerSecond\", \"ReadBytesPerSecond\")\n| extend nodeName = tolower(tostring(split(_ResourceId, \"/\")[8]))\n| summarize BytesPerSec = sum(Val) by nodeName, TimeGenerated = bin(TimeGenerated, 1m)\n| extend method = 2;\nlet netRaw = union perfNet, insightsNet\n| summarize BytesPerSec = sum(BytesPerSec) by nodeName, TimeGenerated = bin(TimeGenerated, 1m), method\n| summarize arg_min(method, BytesPerSec) by nodeName, TimeGenerated;\nnetRaw\n| lookup kind=inner NodeToCluster on nodeName\n| summarize [\"Avg Throughput (MB/s)\"] = round(avg(BytesPerSec) / 1048576.0, 1) by bin(TimeGenerated, step), clusterName\n| order by TimeGenerated asc",
              "size": 0,
              "showAnalytics": true,
              "aggregation": 3,
              "title": "Network Throughput (MB/s) — Selected Instances",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{MachinesLogAnalyticsWorkspace}"
              ],
              "visualization": "linechart",
              "chartSettings": {
                "xAxis": "TimeGenerated",
                "yAxis": [
                  "Avg Throughput (MB/s)"
                ],
                "group": "clusterName",
                "createOtherGroup": null,
                "showLegend": false,
                "seriesLabelSettings": [],
                "ySettings": {
                  "min": 0,
                  "numberFormatSettings": {
                    "unit": 0,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 1
                    }
                  }
                }
              },
              "noDataMessage": "No network-throughput telemetry was returned for the selected instances and time range. Open **Capacity > Overview > Show DCR Setup Guide** to verify Network Interface Bytes Total/sec collection.",
              "noDataMessageStyle": 4
            },
            "customWidth": "100",
            "name": "mc-network-throughput",
            "styleSettings": {
              "margin": "5px",
              "padding": "5px"
            }
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "CapacitySection",
        "comparison": "isEqualTo",
        "value": "multi"
      },
      "name": "cap-multi-section"
    }
  ],
  "fallbackResourceIds": [
    "azure monitor"
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}
