alDisk\" and CounterName == \"Disk Transfers/sec\")\r\n| where InstanceName !~ \"_Total\" and InstanceName !startswith \"HarddiskVolume\"\r\n| where isnotnull(CounterValue) and CounterValue >= 0\r\n| extend nodeName = tolower(Computer)\r\n| extend StorageScope = iff(ObjectName == \"Cluster CSVFS\", \"CSV\", \"Logical disks\")\r\n| summarize arg_max(TimeGenerated, CounterValue) by nodeName, InstanceName, CounterName, StorageScope, Minute = bin(TimeGenerated, 1m)\r\n| summarize Directions = dcount(CounterName), IOPS = sum(CounterValue) by nodeName, InstanceName, StorageScope, Minute\r\n| where Directions == iff(StorageScope == \"CSV\", 2, 1)\r\n| project TimeGenerated = Minute, nodeName, InstanceName, StorageScope, IOPS, method = 1;\r\nlet insightsSamples = InsightsMetrics\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where Namespace == \"LogicalDisk\" and Name in (\"ReadsPerSecond\", \"WritesPerSecond\")\r\n| extend nodeName = tolower(tostring(split(_ResourceId, \"/\")[8]))\r\n| extend InstanceName = tostring(parse_json(Tags)[\"vm.azm.ms/mountId\"])\r\n| where isnotempty(InstanceName) and InstanceName !~ \"_Total\" and InstanceName !startswith \"HarddiskVolume\"\r\n| where isnotnull(Val) and Val >= 0\r\n| summarize arg_max(TimeGenerated, Val) by nodeName, InstanceName, Name, Minute = bin(TimeGenerated, 1m)\r\n| summarize Directions = dcount(Name), IOPS = sum(Val) by nodeName, InstanceName, Minute\r\n| where Directions == 2\r\n| project TimeGenerated = Minute, nodeName, InstanceName, StorageScope = \"Logical disks\", IOPS, method = 2;\r\nlet hostSamples = union perfSamples, insightsSamples\r\n| summarize HostIOPS = sum(IOPS) by nodeName, TimeGenerated = bin(TimeGenerated, 1m), StorageScope, method\r\n| summarize arg_min(method, HostIOPS) by nodeName, TimeGenerated, StorageScope;\r\nlet dailySamples = hostSamples\r\n| lookup kind=inner NodeToCluster on nodeName\r\n| summarize HostIOPS = avg(HostIOPS) by nodeName, clusterName, StorageScope, TimeGenerated = bin(TimeGenerated, step);\r\ndailySamples\r\n| where StorageScope == \"Logical disks\"\r\n| summarize [\"Avg IOPS\"] = round(avg(HostIOPS), 0) by TimeGenerated, clusterName, StorageScope\r\n| project TimeGenerated, clusterName, [\"Avg IOPS\"]\r\n| order by TimeGenerated asc",
