          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let trendStart = {NodeTrendsTimeRange:start};\r\nlet trendEnd = {NodeTrendsTimeRange:end};\r\nlet step = 1d;\r\nlet clusterMap = materialize(\r\n    print mapping = dynamic({ClusterRGMap})\r\n    | mv-expand mapping to typeof(string)\r\n    | extend parts = split(mapping, ':')\r\n    | project nodeRG = tolower(tostring(parts[0])), clusterName = tostring(parts[1]));\r\nlet nodeMap = materialize(\r\n    print mapping = dynamic({ClusterNodeMap})\r\n    | mv-expand mapping to typeof(string)\r\n    | extend parts = split(mapping, ':')\r\n    | project nodeShort = tolower(tostring(parts[0])), clusterName = tostring(parts[1]));\r\nlet clustersWithNodeMap = nodeMap | distinct clusterName;\r\nlet hciNodes = materialize(Heartbeat\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where OSType == \"Windows\"\r\n| summarize arg_max(TimeGenerated, *) by Computer\r\n| project Computer, nodeRG = tolower(ResourceGroup), nodeShort = tolower(tostring(split(Computer, '.')[0]))\r\n| lookup kind=inner clusterMap on nodeRG\r\n| extend hasNodeMap = clusterName in (clustersWithNodeMap)\r\n| join kind=leftouter (nodeMap | project nodeShort, nmCluster=clusterName) on nodeShort\r\n| where hasNodeMap == false or nmCluster == clusterName\r\n| project Computer, clusterName);\r\nlet perfLatency = Perf\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where CounterName in (\"Avg. Disk sec/Read\", \"Avg. Disk sec/Write\") and ObjectName in (\"Cluster CSV File System\", \"Cluster Shared Volume\", \"LogicalDisk\")\r\n| where InstanceName != \"_Total\" and InstanceName != \"HarddiskVolume1\"\r\n| extend method = case(ObjectName == \"Cluster CSV File System\", 1, ObjectName == \"Cluster Shared Volume\", 2, 3)\r\n| extend LatencyMs = CounterValue * 1000.0\r\n| project TimeGenerated, Computer, LatencyMs, method;\r\nlet insightsLatency = InsightsMetrics\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where Namespace == \"LogicalDisk\" and Name in (\"ReadLatencyMs\", \"WriteLatencyMs\")\r\n| extend Computer = tostring(split(_ResourceId, \"/\")[8])\r\n| extend LatencyMs = Val\r\n| project TimeGenerated, Computer, LatencyMs, method = 4;\r\nlet latRaw = union perfLatency, insightsLatency\r\n| summarize HostLatencyMs = avg(LatencyMs) by Computer, TimeGenerated = bin(TimeGenerated, 1m), method\r\n| summarize arg_min(method, HostLatencyMs) by Computer, TimeGenerated;\r\nlet allLatency = materialize(latRaw\r\n| lookup kind=inner hciNodes on Computer\r\n| summarize HostLatencyMs = avg(HostLatencyMs) by Computer, clusterName, TimeGenerated = bin(TimeGenerated, step));\r\nlet top5 = allLatency\r\n| summarize AvgLatency = avg(HostLatencyMs) by clusterName\r\n| top 5 by AvgLatency desc\r\n| project clusterName;\r\nallLatency\r\n| lookup kind=inner top5 on clusterName\r\n| summarize [\"Avg Latency (ms)\"] = round(avg(HostLatencyMs), 2) by TimeGenerated, clusterName\r\n| order by TimeGenerated asc",
              "size": 1,
              "showAnalytics": true,
              "aggregation": 3,
              "title": "Storage Latency (ms) — Top 5 Clusters",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
