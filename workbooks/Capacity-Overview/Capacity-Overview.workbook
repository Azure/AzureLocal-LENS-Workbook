          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let trendStart = {NodeTrendsTimeRange:start};\r\nlet trendEnd = {NodeTrendsTimeRange:end};\r\nlet step = 1d;\r\nlet clusterMap = materialize(\r\n    print mapping = dynamic({ClusterRGMap})\r\n    | mv-expand mapping to typeof(string)\r\n    | extend parts = split(mapping, ':')\r\n    | project nodeRG = tolower(tostring(parts[0])), clusterName = tostring(parts[1]));\r\nlet nodeMap = materialize(\r\n    print mapping = dynamic({ClusterNodeMap})\r\n    | mv-expand mapping to typeof(string)\r\n    | extend parts = split(mapping, ':')\r\n    | project nodeShort = tolower(tostring(parts[0])), clusterName = tostring(parts[1]));\r\nlet clustersWithNodeMap = nodeMap | distinct clusterName;\r\nlet hciNodes = materialize(Heartbeat\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where OSType == \"Windows\"\r\n| summarize arg_max(TimeGenerated, *) by Computer\r\n| project Computer, nodeRG = tolower(ResourceGroup), nodeShort = tolower(tostring(split(Computer, '.')[0]))\r\n| lookup kind=inner clusterMap on nodeRG\r\n| extend hasNodeMap = clusterName in (clustersWithNodeMap)\r\n| join kind=leftouter (nodeMap | project nodeShort, nmCluster=clusterName) on nodeShort\r\n| where hasNodeMap == false or nmCluster == clusterName\r\n| project Computer, clusterName);\r\nlet m1 = Perf\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where ObjectName in (\"Cluster CSV File System\", \"Cluster Shared Volume\") and CounterName in (\"% Used Space\", \"% Free Space\")\r\n| where InstanceName != \"_Total\"\r\n| extend UsedPercent = iff(CounterName == \"% Free Space\", 100.0 - CounterValue, CounterValue)\r\n| extend method = iff(ObjectName == \"Cluster CSV File System\", 1, 2)\r\n| summarize UsedPercent = avg(UsedPercent) by Computer, TimeGenerated = bin(TimeGenerated, step), method;\r\nlet m2 = InsightsMetrics\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where Namespace == \"LogicalDisk\" and Name == \"FreeSpaceMB\"\r\n| extend Computer = tostring(split(_ResourceId, \"/\")[8])\r\n| extend mountId = tostring(parse_json(Tags)[\"vm.azm.ms/mountId\"])\r\n| extend sizeMB = todouble(parse_json(Tags)[\"vm.azm.ms/diskSizeMB\"])\r\n| where isnotempty(mountId) and mountId != \"C:\" and isnotnull(sizeMB) and sizeMB > 0\r\n| summarize FreeMB = avg(Val), TotalMB = max(sizeMB) by Computer, mountId, TimeGenerated = bin(TimeGenerated, step)\r\n| summarize FreeMB = sum(FreeMB), TotalMB = sum(TotalMB) by Computer, TimeGenerated\r\n| where TotalMB > 0\r\n| extend UsedPercent = 100.0 * (1.0 - FreeMB / TotalMB)\r\n| project Computer, TimeGenerated, UsedPercent\r\n| extend method = 3;\r\nlet m3 = Perf\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where ObjectName == \"LogicalDisk\" and CounterName in (\"% Free Space\", \"% Used Space\", \"% Disk Space Used\")\r\n| where InstanceName has \"ClusterStorage\"\r\n| extend UsedPercent = iff(CounterName == \"% Free Space\", 100.0 - CounterValue, CounterValue)\r\n| summarize UsedPercent = avg(UsedPercent) by Computer, TimeGenerated = bin(TimeGenerated, step)\r\n| extend method = 4;\r\nlet m4 = Perf\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where ObjectName == \"LogicalDisk\" and CounterName in (\"% Free Space\", \"% Used Space\", \"% Disk Space Used\")\r\n| where InstanceName != \"_Total\" and InstanceName !startswith \"HarddiskVolume\"\r\n| extend UsedPercent = iff(CounterName == \"% Free Space\", 100.0 - CounterValue, CounterValue)\r\n| summarize UsedPercent = avg(UsedPercent) by Computer, TimeGenerated = bin(TimeGenerated, step)\r\n| extend method = 5;\r\nlet allStorage = materialize(union m1, m2, m3, m4\r\n| summarize arg_min(method, UsedPercent) by Computer, TimeGenerated\r\n| lookup kind=inner hciNodes on Computer);\r\nlet top5 = allStorage\r\n| summarize AvgUsage = avg(UsedPercent) by clusterName\r\n| top 5 by AvgUsage desc\r\n| project clusterName;\r\nallStorage\r\n| lookup kind=inner top5 on clusterName\r\n| summarize [\"Avg Usage %\"] = round(avg(UsedPercent), 1) by bin(TimeGenerated, step), clusterName\r\n| order by TimeGenerated asc",
              "size": 1,
              "showAnalytics": true,
              "aggregation": 3,
              "title": "Storage Usage (%) — Top 5 Clusters",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
