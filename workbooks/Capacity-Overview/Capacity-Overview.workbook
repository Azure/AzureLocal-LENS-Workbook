tend Computer = tostring(split(_ResourceId, \"/\")[8])\r\n| summarize by Computer;\r\nunion perfNodes, insightsNodes\r\n| summarize by Computer\r\n| lookup kind=inner hciNodes on Computer\r\n| summarize Nodes = count()\r\n| extend Label = 'Azure Local Machines:'",
