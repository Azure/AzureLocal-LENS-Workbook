          {
            "type": 1,
            "content": {
              "json": "### 🏗️ Instance: {SingleCluster:label} — Machine and CSV Capacity & Performance"
            },
            "name": "sc-perf-charts-header"
          },
          {
            "type": 1,
            "content": {
              "json": "CPU, host memory and network charts use machine performance data. CSV and logical-disk charts are separate. CSV usage is shown by volume from Event 3002 snapshots; CSV latency and IOPS are shown by machine from Cluster CSVFS counters. Logical-disk usage and performance are shown by machine and may include OS volumes. Missing CSV data remains unavailable."
            },
            "name": "sc-perf-charts-source-tip"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let trendStart = {NodeTrendsTimeRange:start};\nlet trendEnd = {NodeTrendsTimeRange:end};\nlet step = 1d;\n\n// Build authoritative NodeToCluster mapping from ARG (Heartbeat + ClusterRGMap + ClusterNodeMap) — no SDDC dependency\nlet clusterMap = materialize(\n    print mapping = parse_json('{ClusterRGMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeRG = tolower(tostring(parts[0])), clusterName = tostring(parts[1]));\nlet nodeMap = materialize(\n    print mapping = parse_json('{ClusterNodeMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeShort = tolower(tostring(parts[0])), clusterName = tostring(parts[1]), armId = tostring(parts[2]));\nlet thisClusterName = toscalar(nodeMap | where armId =~ '{SingleCluster}' | distinct clusterName | project clusterName);\nlet hasNodeMap = isnotempty(thisClusterName);\nlet NodeToCluster = materialize(\n    Heartbeat\n    | where TimeGenerated between (trendStart .. trendEnd)\n    | where OSType == \"Windows\"\n    | summarize arg_max(TimeGenerated, *) by Computer\n    | extend nodeName = tolower(Computer), nodeRG = tolower(ResourceGroup), nodeShort = tolower(tostring(split(Computer, '.')[0]))\n    | lookup kind=inner clusterMap on nodeRG\n    | where (hasNodeMap and clusterName == thisClusterName) or (hasNodeMap == false)\n    | join kind=leftouter (nodeMap | project nodeShort, nmCluster=clusterName) on nodeShort\n    | where hasNodeMap == false or nmCluster == thisClusterName\n    | project nodeName);\n\nPerf\n| where TimeGenerated between (trendStart .. trendEnd)\n| where ObjectName == \"Processor\" and CounterName == \"% Processor Time\" and InstanceName == \"_Total\"\n| extend nodeName = tolower(Computer)\n| lookup kind=inner NodeToCluster on nodeName\n| summarize [\"Avg Usage %\"] = round(avg(CounterValue), 1) by bin(TimeGenerated, step), nodeName\n| project TimeGenerated, Computer = nodeName, [\"Avg Usage %\"]\n| order by TimeGenerated asc",
              "size": 0,
              "showAnalytics": true,
              "aggregation": 3,
              "title": "CPU Usage (%) — By Machine",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{MachinesLogAnalyticsWorkspace}"
              ],
              "visualization": "linechart",
              "chartSettings": {
                "xAxis": "TimeGenerated",
                "yAxis": [
                  "Avg Usage %"
                ],
                "group": "Computer",
                "createOtherGroup": null,
                "showLegend": true,
                "ySettings": {
                  "min": 0,
                  "max": 100,
                  "numberFormatSettings": {
                    "unit": 1,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 1
                    }
                  }
                }
              },
              "noDataMessage": "No per-machine CPU telemetry was returned for this instance and time range. Open **Capacity & Performance > Overview > Show DCR Setup Guide** to verify the required counter is collected from every machine.",
              "noDataMessageStyle": 4
            },
            "customWidth": "33",
            "name": "sc-cpu-usage-machine",
            "styleSettings": {
              "margin": "5px",
              "padding": "5px"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let trendStart = {NodeTrendsTimeRange:start};\nlet trendEnd = {NodeTrendsTimeRange:end};\nlet step = 1d;\n\n// Build node set from authoritative ARG-derived ClusterNodeMap (filtered to current cluster).\n// Joining via the cluster RG (ClusterRGMap) keeps clusters with no NodeMap entries working.\nlet clusterMap = materialize(\n    print mapping = parse_json('{ClusterRGMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeRG = tolower(tostring(parts[0])), clusterName = tostring(parts[1]));\nlet nodeMap = materialize(\n    print mapping = parse_json('{ClusterNodeMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeShort = tolower(tostring(parts[0])), clusterName = tostring(parts[1]), armId = tostring(parts[2]));\nlet thisCluster = nodeMap | where armId =~ '{SingleCluster}' | distinct clusterName;\nlet thisClusterName = toscalar(thisCluster | project clusterName);\nlet hasNodeMap = isnotempty(thisClusterName);\nlet NodeToCluster = materialize(\n    Heartbeat\n    | where TimeGenerated between (trendStart .. trendEnd)\n    | where OSType == \"Windows\"\n    | summarize arg_max(TimeGenerated, *) by Computer\n    | extend nodeName = tolower(Computer), nodeRG = tolower(ResourceGroup), nodeShort = tolower(tostring(split(Computer, '.')[0]))\n    | lookup kind=inner clusterMap on nodeRG\n    | where (hasNodeMap and clusterName == thisClusterName) or (hasNodeMap == false)\n    | join kind=leftouter (nodeMap | project nodeShort, nmCluster=clusterName) on nodeShort\n    | where hasNodeMap == false or nmCluster == thisClusterName\n    | project nodeName);\n\nPerf\n| where TimeGenerated between (trendStart .. trendEnd)\n| where ObjectName == \"Memory\" and CounterName in (\"Committed Bytes\", \"Available Bytes\")\n| extend nodeName = tolower(Computer)\n| lookup kind=inner NodeToCluster on nodeName\n| summarize\n    Committed = avgif(todouble(CounterValue), CounterName == \"Committed Bytes\"),\n    Available = avgif(todouble(CounterValue), CounterName == \"Available Bytes\"),\n    HaveCommitted = countif(CounterName == \"Committed Bytes\"),\n    HaveAvailable = countif(CounterName == \"Available Bytes\")\n  by bin(TimeGenerated, step), nodeName\n| where HaveCommitted > 0 and HaveAvailable > 0\n| extend Denom = Committed + Available\n| where Denom > 0\n| extend [\"Avg Usage %\"] = round(Committed / Denom * 100.0, 1)\n| project TimeGenerated, Computer = nodeName, [\"Avg Usage %\"]\n| order by TimeGenerated asc",
              "size": 0,
              "showAnalytics": true,
              "aggregation": 3,
              "title": "Memory Usage (%) — By Machine",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{MachinesLogAnalyticsWorkspace}"
              ],
              "visualization": "linechart",
              "chartSettings": {
                "xAxis": "TimeGenerated",
                "yAxis": [
                  "Avg Usage %"
                ],
                "group": "Computer",
                "createOtherGroup": null,
                "showLegend": true,
                "ySettings": {
                  "min": 0,
                  "max": 100,
                  "numberFormatSettings": {
                    "unit": 1,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 1
                    }
                  }
                }
              },
              "noDataMessage": "No per-machine memory telemetry was returned for this instance and time range. Open **Capacity & Performance > Overview > Show DCR Setup Guide** to verify the required counter is collected from every machine.",
              "noDataMessageStyle": 4
            },
            "customWidth": "33",
            "name": "sc-memory-usage-machine",
            "styleSettings": {
              "margin": "5px",
              "padding": "5px"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let trendStart = {NodeTrendsTimeRange:start};\nlet trendEnd = {NodeTrendsTimeRange:end};\nlet step = 1d;\n// Build authoritative NodeToCluster mapping from ARG (Heartbeat + ClusterRGMap + ClusterNodeMap) — no SDDC dependency\nlet clusterMap = materialize(\n    print mapping = parse_json('{ClusterRGMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeRG = tolower(tostring(parts[0])), clusterName = tostring(parts[1]));\nlet nodeMap = materialize(\n    print mapping = parse_json('{ClusterNodeMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeShort = tolower(tostring(parts[0])), clusterName = tostring(parts[1]), armId = tostring(parts[2]));\nlet thisClusterName = toscalar(nodeMap | where armId =~ '{SingleCluster}' | distinct clusterName | project clusterName);\nlet hasNodeMap = isnotempty(thisClusterName);\nlet NodeToCluster = materialize(\n    Heartbeat\n    | where TimeGenerated between (trendStart .. trendEnd)\n    | where OSType == \"Windows\"\n    | summarize arg_max(TimeGenerated, *) by Computer\n    | extend nodeName = tolower(Computer), nodeRG = tolower(ResourceGroup), nodeShort = tolower(tostring(split(Computer, '.')[0]))\n    | lookup kind=inner clusterMap on nodeRG\n    | where (hasNodeMap and clusterName == thisClusterName) or (hasNodeMap == false)\n    | join kind=leftouter (nodeMap | project nodeShort, nmCluster=clusterName) on nodeShort\n    | where hasNodeMap == false or nmCluster == thisClusterName\n    | project nodeName);\nlet perfNetRaw = Perf\n| where TimeGenerated between (trendStart .. trendEnd)\n| where ObjectName in (\"Network Adapter\", \"Network Interface\") and CounterName == \"Bytes Total/sec\"\n| where InstanceName != \"_Total\"\n| extend nodeName = tolower(Computer)\n| extend netRank = iff(ObjectName == \"Network Interface\", 1, 2)\n| project TimeGenerated, nodeName, CounterValue, netRank;\nlet bestNetObject = perfNetRaw | summarize bestNetRank = min(netRank) by nodeName;\nlet perfNet = perfNetRaw\n| lookup kind=inner bestNetObject on nodeName\n| where netRank == bestNetRank\n| summarize BytesPerSec = sum(CounterValue) by nodeName, TimeGenerated = bin(TimeGenerated, 1m)\n| project TimeGenerated, nodeName, BytesPerSec, method = 1;\nlet insightsNet = InsightsMetrics\n| where TimeGenerated between (trendStart .. trendEnd)\n| where Namespace == \"Network\" and Name in (\"WriteBytesPerSecond\", \"ReadBytesPerSecond\")\n| extend nodeName = tolower(tostring(split(_ResourceId, \"/\")[8]))\n| summarize BytesPerSec = sum(Val) by nodeName, TimeGenerated = bin(TimeGenerated, 1m)\n| extend method = 2;\nlet netRaw = union perfNet, insightsNet\n| summarize BytesPerSec = sum(BytesPerSec) by nodeName, TimeGenerated = bin(TimeGenerated, 1m), method\n| summarize arg_min(method, BytesPerSec) by nodeName, TimeGenerated;\nnetRaw\n| lookup kind=inner NodeToCluster on nodeName\n| summarize [\"Avg Throughput (MB/s)\"] = round(avg(BytesPerSec) / 1048576.0, 1) by bin(TimeGenerated, step), nodeName\n| order by TimeGenerated asc",
              "size": 0,
              "showAnalytics": true,
              "aggregation": 3,
              "title": "Network Throughput (MB/s) — By Machine",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{MachinesLogAnalyticsWorkspace}"
              ],
              "visualization": "linechart",
              "chartSettings": {
                "xAxis": "TimeGenerated",
                "yAxis": [
                  "Avg Throughput (MB/s)"
                ],
                "group": "nodeName",
                "createOtherGroup": null,
                "showLegend": false,
                "seriesLabelSettings": [],
                "ySettings": {
                  "min": 0,
                  "numberFormatSettings": {
                    "unit": 0,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 1
                    }
                  }
                }
              },
              "noDataMessage": "No per-machine network throughput telemetry was returned for this instance and time range. Open **Capacity & Performance > Overview > Show DCR Setup Guide** to verify the required counter is collected from every machine.",
              "noDataMessageStyle": 4
            },
            "customWidth": "33",
            "name": "sc-network-throughput-node",
            "styleSettings": {
              "margin": "5px",
              "padding": "5px"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let trendStart = {NodeTrendsTimeRange:start};\r\nlet trendEnd = {NodeTrendsTimeRange:end};\r\nlet step = 1d;\r\n\r\n// Build authoritative NodeToCluster mapping from ARG (Heartbeat + ClusterRGMap + ClusterNodeMap) — no SDDC dependency\r\nlet clusterMap = materialize(\r\n    print mapping = parse_json('{ClusterRGMap}')\r\n    | mv-expand mapping to typeof(string)\r\n    | extend parts = split(mapping, ':')\r\n    | project nodeRG = tolower(tostring(parts[0])), clusterName = tostring(parts[1]));\r\nlet nodeMap = materialize(\r\n    print mapping = parse_json('{ClusterNodeMap}')\r\n    | mv-expand mapping to typeof(string)\r\n    | extend parts = split(mapping, ':')\r\n    | project nodeShort = tolower(tostring(parts[0])), clusterName = tostring(parts[1]), armId = tostring(parts[2]));\r\nlet thisClusterName = toscalar(nodeMap | where armId =~ '{SingleCluster}' | distinct clusterName | project clusterName);\r\nlet hasNodeMap = isnotempty(thisClusterName);\r\nlet NodeToCluster = materialize(\r\n    Heartbeat\r\n    | where TimeGenerated between (trendStart .. trendEnd)\r\n    | where OSType == \"Windows\"\r\n    | summarize arg_max(TimeGenerated, *) by Computer\r\n    | extend nodeName = tolower(Computer), nodeRG = tolower(ResourceGroup), nodeShort = tolower(tostring(split(Computer, '.')[0]))\r\n    | lookup kind=inner clusterMap on nodeRG\r\n    | where (hasNodeMap and clusterName == thisClusterName) or (hasNodeMap == false)\r\n    | join kind=leftouter (nodeMap | project nodeShort, nmCluster=clusterName) on nodeShort\r\n    | where hasNodeMap == false or nmCluster == thisClusterName\r\n    | project nodeName);\r\n\r\nlet csvClusterMap = print mapping = parse_json('{ClusterNodeMap}')\r\n| mv-expand mapping to typeof(string)\r\n| extend parts = split(mapping, ':')\r\n| project ClusterArmId = tolower(tostring(parts[2])), clusterName = tostring(parts[1])\r\n| where isnotempty(ClusterArmId)\r\n| distinct ClusterArmId, clusterName;\r\nlet csvVolumes = Event\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where EventLog =~ \"Microsoft-Windows-SDDC-Management/Operational\" and EventID == 3002\r\n| extend ClusterArmId = tolower(tostring(parse_xml(tostring(EventData)).DataItem.UserData.EventData[\"ArmId\"]))\r\n| where ClusterArmId =~ \"{SingleCluster}\"\r\n| extend Volumes = parse_json(RenderedDescription).VolumeList\r\n| where isnotempty(ClusterArmId) and array_length(Volumes) > 0\r\n| lookup kind=inner csvClusterMap on ClusterArmId\r\n| summarize arg_max(TimeGenerated, Volumes) by ClusterArmId, clusterName, Day = bin(TimeGenerated, step)\r\n| mv-expand volume = Volumes\r\n| extend VolumeLabel = tostring(volume.m_Label), TotalBytes = todouble(volume.m_Size), UsedBytes = todouble(volume.m_SizeUsed)\r\n| extend VolumeId = coalesce(tostring(volume.m_Id), tostring(volume.m_Path), VolumeLabel)\r\n| where isnotempty(VolumeLabel) and VolumeLabel !contains \"ClusterPerformanceHistory\"\r\n| where TotalBytes > 0 and isnotnull(UsedBytes) and UsedBytes >= 0 and UsedBytes <= TotalBytes\r\n| summarize arg_max(TimeGenerated, TotalBytes, UsedBytes, VolumeLabel) by ClusterArmId, clusterName, VolumeId, Day;\r\nlet m2 = InsightsMetrics\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where Namespace == \"LogicalDisk\" and Name == \"FreeSpaceMB\"\r\n| extend nodeName = tolower(tostring(split(_ResourceId, \"/\")[8]))\r\n| extend mountId = tostring(parse_json(Tags)[\"vm.azm.ms/mountId\"])\r\n| extend sizeMB = todouble(parse_json(Tags)[\"vm.azm.ms/diskSizeMB\"])\r\n| where isnotempty(mountId) and mountId != \"C:\" and isnotnull(sizeMB) and sizeMB > 0\r\n| summarize FreeMB = avg(Val), TotalMB = max(sizeMB) by nodeName, mountId, TimeGenerated = bin(TimeGenerated, step)\r\n| summarize FreeMB = sum(FreeMB), TotalMB = sum(TotalMB) by nodeName, TimeGenerated\r\n| where TotalMB > 0\r\n| extend UsedPercent = 100.0 * (1.0 - FreeMB / TotalMB)\r\n| project nodeName, TimeGenerated, UsedPercent\r\n| extend method = 3;\r\n\r\nlet m3 = Perf\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where ObjectName == \"LogicalDisk\" and CounterName in (\"% Free Space\", \"% Used Space\", \"% Disk Space Used\")\r\n| where InstanceName has \"ClusterStorage\"\r\n| extend nodeName = tolower(Computer)\r\n| extend UsedPercent = iff(CounterName == \"% Free Space\", 100.0 - CounterValue, CounterValue)\r\n| summarize UsedPercent = avg(UsedPercent) by nodeName, TimeGenerated = bin(TimeGenerated, step)\r\n| extend method = 4;\r\n\r\nlet m4 = Perf\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where ObjectName == \"LogicalDisk\" and CounterName in (\"% Free Space\", \"% Used Space\", \"% Disk Space Used\")\r\n| where InstanceName != \"_Total\" and InstanceName !startswith \"HarddiskVolume\"\r\n| extend nodeName = tolower(Computer)\r\n| extend UsedPercent = iff(CounterName == \"% Free Space\", 100.0 - CounterValue, CounterValue)\r\n| summarize UsedPercent = avg(UsedPercent) by nodeName, TimeGenerated = bin(TimeGenerated, step)\r\n| extend method = 5;\r\n\r\nlet logicalCapacity = union m2, m3, m4\r\n| summarize arg_min(method, UsedPercent) by nodeName, TimeGenerated\r\n| lookup kind=inner NodeToCluster on nodeName\r\n| summarize UsedPercent = avg(UsedPercent) by nodeName, TimeGenerated\r\n| extend StorageScope = \"Logical disks\";\r\nlet volumeLabels = csvVolumes | summarize LabelVolumes = dcount(VolumeId) by VolumeLabel;\r\nlet csvCapacity = csvVolumes\r\n| lookup kind=leftouter volumeLabels on VolumeLabel\r\n| extend VolumeLabel = iff(LabelVolumes > 1, strcat(VolumeLabel, \" [\", VolumeId, \"]\"), VolumeLabel)\r\n| extend UsedPercent = 100.0 * UsedBytes / TotalBytes\r\n| project TimeGenerated = Day, Computer = VolumeLabel, UsedPercent;\r\nlet hostCapacity = logicalCapacity\r\n| project TimeGenerated, Computer = nodeName, UsedPercent;\r\ncsvCapacity\r\n| project TimeGenerated, Computer, [\"Avg Usage %\"] = round(UsedPercent, 1)\r\n| order by TimeGenerated asc",
              "size": 0,
              "showAnalytics": true,
              "aggregation": 3,
              "title": "CSV Volume Usage (%) - By Volume",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{MachinesLogAnalyticsWorkspace}"
              ],
              "visualization": "linechart",
              "chartSettings": {
                "xAxis": "TimeGenerated",
                "yAxis": [
                  "Avg Usage %"
                ],
                "group": "Computer",
                "createOtherGroup": null,
                "showLegend": true,
                "ySettings": {
                  "min": 0,
                  "max": 100,
                  "numberFormatSettings": {
                    "unit": 1,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 1
                    }
                  }
                }
              },
              "noDataMessage": "No CSV volume capacity snapshots in the selected instance. Collect Event 3002 VolumeList data using the DCR setup guide.",
              "noDataMessageStyle": 4
            },
            "customWidth": "33",
            "name": "sc-storage-usage-machine",
            "styleSettings": {
              "margin": "5px",
              "padding": "5px"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let trendStart = {NodeTrendsTimeRange:start};\nlet trendEnd = {NodeTrendsTimeRange:end};\nlet step = 1d;\n\n// Build authoritative NodeToCluster mapping from ARG (Heartbeat + ClusterRGMap + ClusterNodeMap) — no SDDC dependency\nlet clusterMap = materialize(\n    print mapping = parse_json('{ClusterRGMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeRG = tolower(tostring(parts[0])), clusterName = tostring(parts[1]));\nlet nodeMap = materialize(\n    print mapping = parse_json('{ClusterNodeMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeShort = tolower(tostring(parts[0])), clusterName = tostring(parts[1]), armId = tostring(parts[2]));\nlet thisClusterName = toscalar(nodeMap | where armId =~ '{SingleCluster}' | distinct clusterName | project clusterName);\nlet hasNodeMap = isnotempty(thisClusterName);\nlet NodeToCluster = materialize(\n    Heartbeat\n    | where TimeGenerated between (trendStart .. trendEnd)\n    | where OSType == \"Windows\"\n    | summarize arg_max(TimeGenerated, *) by Computer\n    | extend nodeName = tolower(Computer), nodeRG = tolower(ResourceGroup), nodeShort = tolower(tostring(split(Computer, '.')[0]))\n    | lookup kind=inner clusterMap on nodeRG\n    | where (hasNodeMap and clusterName == thisClusterName) or (hasNodeMap == false)\n    | join kind=leftouter (nodeMap | project nodeShort, nmCluster=clusterName) on nodeShort\n    | where hasNodeMap == false or nmCluster == thisClusterName\n    | project nodeName);\n\n// Latency only exists in Perf (ReadLatencyMs absent from InsightsMetrics)\nlet perfSamples = Perf\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where (ObjectName == \"Cluster CSVFS\" and CounterName in (\"Avg. sec/Read\", \"Avg. sec/Write\")) or (ObjectName == \"LogicalDisk\" and CounterName in (\"Avg. Disk sec/Read\", \"Avg. Disk sec/Write\"))\r\n| where InstanceName !~ \"_Total\" and InstanceName !startswith \"HarddiskVolume\"\r\n| where isnotnull(CounterValue) and CounterValue >= 0\r\n| extend nodeName = tolower(Computer)\r\n| extend StorageScope = iff(ObjectName == \"Cluster CSVFS\", \"CSV\", \"Logical disks\")\r\n| summarize arg_max(TimeGenerated, CounterValue) by nodeName, InstanceName, CounterName, StorageScope, Minute = bin(TimeGenerated, 1m)\r\n| summarize Directions = dcount(CounterName), LatencyMs = avg(CounterValue) * 1000.0 by nodeName, InstanceName, StorageScope, Minute\r\n| where Directions == 2\r\n| project TimeGenerated = Minute, nodeName, InstanceName, StorageScope, LatencyMs, method = 1;\r\nlet hostSamples = perfSamples\r\n| summarize HostLatencyMs = avg(LatencyMs) by nodeName, TimeGenerated = bin(TimeGenerated, 1m), StorageScope, method\r\n| summarize arg_min(method, HostLatencyMs) by nodeName, TimeGenerated, StorageScope;\r\nlet dailySamples = hostSamples\r\n| lookup kind=inner NodeToCluster on nodeName\r\n| summarize HostLatencyMs = avg(HostLatencyMs) by nodeName, StorageScope, TimeGenerated = bin(TimeGenerated, step);\r\ndailySamples\r\n| where StorageScope == \"CSV\"\r\n| summarize [\"Avg Latency (ms)\"] = round(avg(HostLatencyMs), 2) by TimeGenerated, nodeName, StorageScope\r\n| extend Computer = nodeName\r\n| project TimeGenerated, Computer, [\"Avg Latency (ms)\"]\r\n| order by TimeGenerated asc",
              "size": 0,
              "showAnalytics": true,
