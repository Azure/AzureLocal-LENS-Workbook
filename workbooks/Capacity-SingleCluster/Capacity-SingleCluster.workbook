              "json": "### 💾 Instance: {SingleCluster:label} — Storage Volume Usage and Forecast"
            },
            "name": "sc-storage-bar-header"
          },
          {
            "type": 1,
            "content": {
              "json": "💡 **Tip:** The chart below uses [Storage Path](https://learn.microsoft.com/en-us/azure-stack/hci/manage/create-storage-path) resources in Azure to report volume usage data."
            },
            "conditionalVisibility": {
              "parameterName": "ClusterFilter",
              "comparison": "isNotEqualTo",
              "value": "value::all"
            },
            "name": "text-storage-paths-tip"
          },
          {
            "type": 1,
            "content": {
              "json": "⚠️ **Multi-instance resource group detected.** This instance shares its resource group with: **{MultiClusterRGSiblings}**. Because Azure Resource Graph cannot uniquely attribute storage containers back to a single HCI instance when multiple instances share a resource group, the chart below is **RG-wide** and may include volumes owned by the sibling instance(s).",
              "style": "warning"
            },
            "conditionalVisibility": {
              "parameterName": "MultiClusterRGSiblings",
              "comparison": "isNotEqualTo",
              "value": ""
            },
            "name": "sc-multi-cluster-rg-warning-storage"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\r\n| where type == \"microsoft.azurestackhci/storagecontainers\"\r\n| where '{ResourceGroupFilter}' == '' or resourceGroup matches regex strcat('(?i)', replace_string(replace_string('{ResourceGroupFilter}', '*', '.*'), '?', '.'))\r\n| extend customLocKey = tolower(trim_end(\"/\", tostring(extendedLocation.name)))\r\n| join kind=inner (\r\n    resources\r\n    | where type == \"microsoft.extendedlocation/customlocations\"\r\n    | where tostring(properties.hostResourceId) contains \"Microsoft.ResourceConnector/appliances\"\r\n    | extend hostResourceId = tolower(tostring(properties.hostResourceId))\r\n    | extend resourceGroupKey = strcat(tostring(split(hostResourceId, '/')[2]), ':', tostring(split(hostResourceId, '/')[4]))\r\n    | project customLocKey = tolower(trim_end(\"/\", id)), resourceGroupKey\r\n) on customLocKey\r\n| join kind=inner (\r\n    resources\r\n    | where type == \"microsoft.azurestackhci/clusters\"\r\n    | where id =~ '{SingleCluster}'\r\n    | where '{ResourceGroupFilter}' == '' or resourceGroup matches regex strcat('(?i)', replace_string(replace_string('{ResourceGroupFilter}', '*', '.*'), '?', '.'))\r\n    | project clusterName = name, resourceGroupKey = strcat(tolower(subscriptionId), ':', tolower(resourceGroup))\r\n) on resourceGroupKey\r\n| extend pathName = name\r\n| extend totalGB = round(toreal(properties.status.containerSizeMB) / 1024, 0)\r\n| extend availableGB = round(toreal(properties.status.availableSizeMB) / 1024, 0)\r\n| extend usedGB = totalGB - availableGB\r\n| project pathName, UsedGB = usedGB, AvailableGB = availableGB\r\n| order by pathName asc",
              "size": 0,
              "showAnalytics": true,
              "aggregation": 3,
              "title": "Storage Volume Usage (GB) — {SingleCluster:label}",
              "noDataMessage": "No storage containers found for this instance.",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "visualization": "barchart",
              "chartSettings": {
                "xAxis": "pathName",
                "yAxis": [
                  "UsedGB",
                  "AvailableGB"
                ],
                "group": null,
                "createOtherGroup": null,
                "showDataPointsCount": true,
                "seriesLabelSettings": [],
                "ySettings": {
                  "numberFormatSettings": {
                    "unit": 0
                  }
                },
                "showLegend": false
              }
            },
            "customWidth": "50",
            "conditionalVisibility": {
              "parameterName": "ClusterFilter",
              "comparison": "isNotEqualTo",
              "value": "value::all"
            },
            "name": "sc-storage-paths-chart",
            "styleSettings": {
              "margin": "5px",
              "padding": "5px"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let trendStart  = {NodeTrendsTimeRange:start};\r\nlet trendEnd    = {NodeTrendsTimeRange:end};\r\nlet horizonDays = toint('{ForecastHorizonDays}');\r\nlet step        = 1d;\r\nlet seriesEnd   = trendEnd + horizonDays*step;\r\n\r\n// seasonality = lookback/2 expressed as #points\r\nlet lookback = trendEnd - trendStart;\r\nlet seasonalityPoints = max_of(2, toint((lookback / 2) / step));\r\n\r\n// 1) Daily Used% per volume (SingleCluster)\r\nlet csvClusterMap = print mapping = parse_json('{ClusterNodeMap}')\r\n| mv-expand mapping to typeof(string)\r\n| extend parts = split(mapping, ':')\r\n| project ClusterArmId = tolower(tostring(parts[2])), clusterName = tostring(parts[1])\r\n| where isnotempty(ClusterArmId)\r\n| distinct ClusterArmId, clusterName;\r\nlet csvVolumes = Event\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where EventLog =~ \"Microsoft-Windows-SDDC-Management/Operational\" and EventID == 3002\r\n| extend ClusterArmId = tolower(tostring(parse_xml(tostring(EventData)).DataItem.UserData.EventData[\"ArmId\"]))\r\n| where ClusterArmId =~ \"{SingleCluster}\"\r\n| extend Volumes = parse_json(RenderedDescription).VolumeList\r\n| where isnotempty(ClusterArmId) and array_length(Volumes) > 0\r\n| lookup kind=inner csvClusterMap on ClusterArmId\r\n| summarize arg_max(TimeGenerated, Volumes) by ClusterArmId, clusterName, Day = bin(TimeGenerated, step)\r\n| mv-expand volume = Volumes\r\n| extend VolumeLabel = tostring(volume.m_Label), TotalBytes = todouble(volume.m_Size), UsedBytes = todouble(volume.m_SizeUsed)\r\n| extend VolumeId = coalesce(tostring(volume.m_Id), tostring(volume.m_Path), VolumeLabel)\r\n| where isnotempty(VolumeLabel) and VolumeLabel !contains \"ClusterPerformanceHistory\"\r\n| where TotalBytes > 0 and isnotnull(UsedBytes) and UsedBytes >= 0 and UsedBytes <= TotalBytes\r\n| summarize arg_max(TimeGenerated, TotalBytes, UsedBytes, VolumeLabel) by ClusterArmId, clusterName, VolumeId, Day;\r\nlet volumeLabels = csvVolumes | summarize LabelVolumes = dcount(VolumeId) by VolumeLabel;\r\nlet perVolumePerDay = csvVolumes\r\n| lookup kind=leftouter volumeLabels on VolumeLabel\r\n| extend VolumeLabel = iff(LabelVolumes > 1, strcat(VolumeLabel, \" [\", VolumeId, \"]\"), VolumeLabel)\r\n| project VolumeLabel, TimeGenerated = Day, UsedPct = 100.0 * UsedBytes / TotalBytes;\r\n// 2) One series per volume -> forecast per volume -> expand (CPU style)\r\nperVolumePerDay\r\n| make-series UsedPct = avg(UsedPct) default=double(null)\r\n    on TimeGenerated\r\n    from trendStart to seriesEnd step step\r\n    by VolumeLabel\r\n| extend UsedSmooth = series_fill_forward(series_fill_backward(series_fill_linear(UsedPct)))\r\n| extend (forecast, trend, seasonal, residual) =\r\n    series_decompose_forecast(UsedSmooth, horizonDays, seasonalityPoints, \"linefit\")\r\n| mv-expand\r\n    TimeGenerated to typeof(datetime),\r\n    UsedSmooth to typeof(double),\r\n    forecast to typeof(double)\r\n| extend\r\n    Actual   = iff(TimeGenerated <= trendEnd, UsedSmooth, real(null)),\r\n    Forecast = iff(TimeGenerated > trendEnd, forecast, real(null))\r\n| extend\r\n    Series = pack_array(strcat(VolumeLabel, \" - Actual\"), strcat(VolumeLabel, \" - Forecast\")),\r\n    Value  = pack_array(Actual, Forecast)\r\n| mv-expand Series to typeof(string), Value to typeof(double)\r\n| where isnotnull(Value)\r\n| project TimeGenerated, Series, Value\r\n| order by TimeGenerated asc",
              "size": 0,
              "showAnalytics": true,
              "aggregation": 3,
              "title": "Volume Usage (%) - Single instance",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{MachinesLogAnalyticsWorkspace}"
              ],
              "visualization": "timechart",
              "chartSettings": {
                "xAxis": "TimeGenerated",
                "yAxis": [
                  "Value"
                ],
                "group": "Series",
                "createOtherGroup": null,
                "showLegend": false,
                "seriesLabelSettings": []
              },
              "noDataMessage": "No volume usage data for this instance. This chart reads `Microsoft-Windows-SDDC-Management/Operational` Event ID 3002 from the Log Analytics workspace — confirm Azure Monitor Agent (AMA) and a Data Collection Rule (DCR) collecting that event log are deployed to the instance machines.",
              "noDataMessageStyle": 4
            },
            "customWidth": "50",
            "name": "single-cluster-volume-usage",
            "styleSettings": {
              "margin": "5px",
              "padding": "5px"
            }
          },
          {
            "type": 1,
            "content": {
              "json": "### CSV Volume Free Space Trends and Forecast"
            },
            "name": "sc-stor-forecast-header"
          },
          {
            "type": 1,
            "content": {
              "json": "CSV capacity and forecasts use Event 3002 VolumeList snapshots from Microsoft-Windows-SDDC-Management/Operational. Values describe logical CSV volume capacity, not physical S2D pool headroom. One latest snapshot per instance/day is selected before volumes are summed. Missing or invalid volume sizes remain unavailable."
            },
            "name": "sc-stor-forecast-source-tip"
          },
          {
            "type": 1,
            "content": {
              "json": "⚠️ **Forecast:** These lines extrapolate the selected historical trend with linear regression. Treat them as directional planning indicators, not predictions; workload or seasonal changes can produce different results.",
              "style": "warning"
            },
            "name": "sc-stor-forecast-disclaimer-tip"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// Storage Available (%) - Actual vs Forecast (Single cluster)\r\nlet trendStart  = {NodeTrendsTimeRange:start};\r\nlet trendEnd    = {NodeTrendsTimeRange:end};\r\nlet horizonDays = toint('{ForecastHorizonDays}');\r\nlet step        = 1d;\r\nlet seriesEnd   = trendEnd + horizonDays*step;\r\n\r\n// seasonality = lookback/2 expressed as #points\r\nlet lookback = trendEnd - trendStart;\r\nlet seasonalityPoints = max_of(2, toint((lookback / 2) / step));\r\n\r\nlet csvClusterMap = print mapping = parse_json('{ClusterNodeMap}')\r\n| mv-expand mapping to typeof(string)\r\n| extend parts = split(mapping, ':')\r\n| project ClusterArmId = tolower(tostring(parts[2])), clusterName = tostring(parts[1])\r\n| where isnotempty(ClusterArmId)\r\n| distinct ClusterArmId, clusterName;\r\nlet csvVolumes = Event\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where EventLog =~ \"Microsoft-Windows-SDDC-Management/Operational\" and EventID == 3002\r\n| extend ClusterArmId = tolower(tostring(parse_xml(tostring(EventData)).DataItem.UserData.EventData[\"ArmId\"]))\r\n| where ClusterArmId =~ \"{SingleCluster}\"\r\n| extend Volumes = parse_json(RenderedDescription).VolumeList\r\n| where isnotempty(ClusterArmId) and array_length(Volumes) > 0\r\n| lookup kind=inner csvClusterMap on ClusterArmId\r\n| summarize arg_max(TimeGenerated, Volumes) by ClusterArmId, clusterName, Day = bin(TimeGenerated, step)\r\n| mv-expand volume = Volumes\r\n| extend VolumeLabel = tostring(volume.m_Label), TotalBytes = todouble(volume.m_Size), UsedBytes = todouble(volume.m_SizeUsed)\r\n| extend VolumeId = coalesce(tostring(volume.m_Id), tostring(volume.m_Path), VolumeLabel)\r\n| where isnotempty(VolumeLabel) and VolumeLabel !contains \"ClusterPerformanceHistory\"\r\n| where TotalBytes > 0 and isnotnull(UsedBytes) and UsedBytes >= 0 and UsedBytes <= TotalBytes\r\n| summarize arg_max(TimeGenerated, TotalBytes, UsedBytes, VolumeLabel) by ClusterArmId, clusterName, VolumeId, Day;\r\nlet perDay = csvVolumes\r\n| summarize TotalBytes = sum(TotalBytes), UsedBytes = sum(UsedBytes) by ClusterArmId, TimeGenerated = Day\r\n| extend AvailableBytes = TotalBytes - UsedBytes\r\n| project TimeGenerated, AvailablePct = 100.0 * AvailableBytes / TotalBytes;\r\n// Forecast\r\nperDay\r\n| make-series AvgValue = avg(AvailablePct) default=double(null)\r\n    on TimeGenerated\r\n    from trendStart to seriesEnd step step\r\n| extend AvgValueSmooth = series_fill_forward(series_fill_backward(series_fill_linear(AvgValue)))\r\n| extend (forecast, trend, seasonal, residual) =\r\n        series_decompose_forecast(AvgValueSmooth, horizonDays, seasonalityPoints, \"linefit\")\r\n| mv-expand\r\n    TimeGenerated to typeof(datetime),\r\n    AvgValueSmooth to typeof(double),\r\n    forecast to typeof(double),\r\n    trend to typeof(double)\r\n| extend\r\n    Actual     = iff(TimeGenerated <= trendEnd, AvgValueSmooth, real(null)),\r\n    Projection = iff(TimeGenerated > trendEnd, forecast, real(null))\r\n| extend\r\n    Series = pack_array(\"Actual\",\"Forecast\"),\r\n    Value  = pack_array(Actual, Projection)\r\n| mv-expand Series to typeof(string), Value to typeof(double)\r\n| where isnotnull(Value)\r\n| project TimeGenerated, Series, Value\r\n| order by TimeGenerated asc",
              "size": 0,
              "showAnalytics": true,
              "aggregation": 3,
              "title": "CSV Volume Free Space (%) - Actual vs Forecast",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{MachinesLogAnalyticsWorkspace}"
              ],
              "visualization": "linechart",
              "sortBy": [],
              "tileSettings": {
                "showBorder": false
              },
              "graphSettings": {
                "type": 0
              },
              "chartSettings": {
                "xAxis": "TimeGenerated",
                "yAxis": [
                  "Value"
                ],
                "group": "Series",
                "seriesLabelKey": "Series",
                "showLegend": false,
                "seriesLabelSettings": [],
                "ySettings": {
                  "min": 0,
                  "max": 100
                }
              },
              "mapSettings": {
                "locInfo": "AzureResource",
                "locInfoColumn": "ArmId"
              },
              "noDataMessage": "No Event ID 3002 storage-capacity telemetry was returned for this instance and time range. Open **Capacity & Performance > Overview > Show DCR Setup Guide** to verify event collection.",
              "noDataMessageStyle": 4
            },
            "customWidth": "50",
            "name": "single-cluster-storage-pool-trend",
            "styleSettings": {
              "margin": "5px",
              "padding": "5px"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// Storage Available (TB) - Actual vs Forecast (ClusterFilter multi-select + includeAll)\r\nlet trendStart  = {NodeTrendsTimeRange:start};\r\nlet trendEnd    = {NodeTrendsTimeRange:end};\r\nlet horizonDays = toint('{ForecastHorizonDays}');\r\nlet step        = 1d;\r\nlet seriesEnd   = trendEnd + horizonDays*step;\r\n\r\n// seasonality = lookback/2 expressed as #points\r\nlet lookback = trendEnd - trendStart;\r\nlet seasonalityPoints = max_of(2, toint((lookback / 2) / step));  // remove max_of if you want it pure\r\n\r\n// Detect \"All\" selection (value::all injected by parameter includeAll)\r\nlet isAllClusters = false; // single cluster view\r\n\r\nlet csvClusterMap = print mapping = parse_json('{ClusterNodeMap}')\r\n| mv-expand mapping to typeof(string)\r\n| extend parts = split(mapping, ':')\r\n| project ClusterArmId = tolower(tostring(parts[2])), clusterName = tostring(parts[1])\r\n| where isnotempty(ClusterArmId)\r\n| distinct ClusterArmId, clusterName;\r\nlet csvVolumes = Event\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where EventLog =~ \"Microsoft-Windows-SDDC-Management/Operational\" and EventID == 3002\r\n| extend ClusterArmId = tolower(tostring(parse_xml(tostring(EventData)).DataItem.UserData.EventData[\"ArmId\"]))\r\n| where ClusterArmId =~ \"{SingleCluster}\"\r\n| extend Volumes = parse_json(RenderedDescription).VolumeList\r\n| where isnotempty(ClusterArmId) and array_length(Volumes) > 0\r\n| lookup kind=inner csvClusterMap on ClusterArmId\r\n| summarize arg_max(TimeGenerated, Volumes) by ClusterArmId, clusterName, Day = bin(TimeGenerated, step)\r\n| mv-expand volume = Volumes\r\n| extend VolumeLabel = tostring(volume.m_Label), TotalBytes = todouble(volume.m_Size), UsedBytes = todouble(volume.m_SizeUsed)\r\n| extend VolumeId = coalesce(tostring(volume.m_Id), tostring(volume.m_Path), VolumeLabel)\r\n| where isnotempty(VolumeLabel) and VolumeLabel !contains \"ClusterPerformanceHistory\"\r\n| where TotalBytes > 0 and isnotnull(UsedBytes) and UsedBytes >= 0 and UsedBytes <= TotalBytes\r\n| summarize arg_max(TimeGenerated, TotalBytes, UsedBytes, VolumeLabel) by ClusterArmId, clusterName, VolumeId, Day;\r\nlet perDay = csvVolumes\r\n| summarize TotalBytes = sum(TotalBytes), UsedBytes = sum(UsedBytes) by ClusterArmId, TimeGenerated = Day\r\n| extend AvailableBytes = TotalBytes - UsedBytes\r\n| project TimeGenerated, AvailableTB = AvailableBytes / 1e12;\r\n\r\nperDay\r\n| make-series AvgValue = avg(AvailableTB) default=double(null)\r\n    on TimeGenerated\r\n    from trendStart to seriesEnd step step\r\n| extend AvgValueSmooth = series_fill_forward(series_fill_backward(series_fill_linear(AvgValue)))\r\n| extend (forecast, trend, seasonal, residual) =\r\n        series_decompose_forecast(AvgValueSmooth, horizonDays, seasonalityPoints, \"linefit\")\r\n| mv-expand\r\n    TimeGenerated to typeof(datetime),\r\n    AvgValueSmooth to typeof(double),\r\n    forecast to typeof(double),\r\n    trend to typeof(double)\r\n| extend\r\n    Actual     = iff(TimeGenerated <= trendEnd, AvgValueSmooth, real(null)),\r\n    Projection = iff(TimeGenerated > trendEnd, forecast, real(null))\r\n| extend\r\n    Series = pack_array(\"Actual\",\"Forecast\"),\r\n    Value  = pack_array(Actual, Projection)\r\n| mv-expand Series to typeof(string), Value to typeof(double)\r\n| where isnotnull(Value)\r\n| project TimeGenerated, Series, Value\r\n| order by TimeGenerated asc",
              "size": 0,
              "aggregation": 3,
              "title": "CSV Volume Free Space (TB) - Actual vs Forecast",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{MachinesLogAnalyticsWorkspace}"
              ],
              "visualization": "linechart",
              "sortBy": [],
              "tileSettings": {
                "showBorder": false
              },
              "graphSettings": {
                "type": 0
              },
              "chartSettings": {
                "xAxis": "TimeGenerated",
                "yAxis": [
                  "Value"
                ],
                "group": "Series",
                "seriesLabelKey": "Series",
                "showLegend": false,
                "seriesLabelSettings": []
              },
              "mapSettings": {
                "locInfo": "AzureResource",
                "locInfoColumn": "ArmId"
              }
            },
            "customWidth": "50",
            "name": "single-cluster-storage-pool-trend - Copy",
            "styleSettings": {
              "margin": "5px",
              "padding": "5px"
            }
          },
          {
            "type": 1,
            "content": {
              "json": "---\r\n### Cluster Shared Volumes - Per Machine Detailed Analysis"
            },
            "name": "sc-storage-detail-header"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{MachinesLogAnalyticsWorkspace}"
              ],
              "style": "pills",
              "parameters": [
                {
                  "version": "KqlParameterItem/1.0",
                  "type": 2,
                  "isRequired": true,
                  "multiSelect": false,
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "queryType": 0,
                  "resourceType": "microsoft.operationalinsights/workspaces",
                  "crossComponentResources": [
                    "{MachinesLogAnalyticsWorkspace}"
                  ],
                  "id": "sc-storage-detail-machine",
                  "name": "SCStorageDetailMachine",
                  "label": "Machine",
                  "quote": "",
                  "timeContextFromParameter": "NodeTrendsTimeRange",
                  "query": "let trendStart = {NodeTrendsTimeRange:start};\nlet trendEnd = {NodeTrendsTimeRange:end};\nlet step = 1d;\n\n// Build authoritative NodeToCluster mapping from ARG (Heartbeat + ClusterRGMap + ClusterNodeMap) — no SDDC dependency\nlet clusterMap = materialize(\n    print mapping = parse_json('{ClusterRGMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeRG = tolower(tostring(parts[0])), clusterName = tostring(parts[1]));\nlet nodeMap = materialize(\n    print mapping = parse_json('{ClusterNodeMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeShort = tolower(tostring(parts[0])), clusterName = tostring(parts[1]), armId = tostring(parts[2]));\nlet thisClusterName = toscalar(nodeMap | where armId =~ '{SingleCluster}' | distinct clusterName | project clusterName);\nlet hasNodeMap = isnotempty(thisClusterName);\nlet NodeToCluster = materialize(\n    Heartbeat\n    | where TimeGenerated between (trendStart .. trendEnd)\n    | where OSType == \"Windows\"\n    | summarize arg_max(TimeGenerated, *) by Computer\n    | extend nodeName = tolower(Computer), nodeRG = tolower(ResourceGroup), nodeShort = tolower(tostring(split(Computer, '.')[0]))\n    | lookup kind=inner clusterMap on nodeRG\n    | where (hasNodeMap and clusterName == thisClusterName) or (hasNodeMap == false)\n    | join kind=leftouter (nodeMap | project nodeShort, nmCluster=clusterName) on nodeShort\n    | where hasNodeMap == false or nmCluster == thisClusterName\n    | project nodeName);\n\nNodeToCluster\r\n| distinct nodeName\r\n| order by nodeName asc\r\n| serialize\r\n| project value = nodeName, label = nodeName, selected = row_number() == 1"
                }
              ]
            },
            "name": "sc-storage-detail-filters"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let trendStart = {NodeTrendsTimeRange:start};\nlet trendEnd = {NodeTrendsTimeRange:end};\nlet step = 1d;\n\n// Build authoritative NodeToCluster mapping from ARG (Heartbeat + ClusterRGMap + ClusterNodeMap) — no SDDC dependency\nlet clusterMap = materialize(\n    print mapping = parse_json('{ClusterRGMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeRG = tolower(tostring(parts[0])), clusterName = tostring(parts[1]));\nlet nodeMap = materialize(\n    print mapping = parse_json('{ClusterNodeMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeShort = tolower(tostring(parts[0])), clusterName = tostring(parts[1]), armId = tostring(parts[2]));\nlet thisClusterName = toscalar(nodeMap | where armId =~ '{SingleCluster}' | distinct clusterName | project clusterName);\nlet hasNodeMap = isnotempty(thisClusterName);\nlet NodeToCluster = materialize(\n    Heartbeat\n    | where TimeGenerated between (trendStart .. trendEnd)\n    | where OSType == \"Windows\"\n    | summarize arg_max(TimeGenerated, *) by Computer\n    | extend nodeName = tolower(Computer), nodeRG = tolower(ResourceGroup), nodeShort = tolower(tostring(split(Computer, '.')[0]))\n    | lookup kind=inner clusterMap on nodeRG\n    | where (hasNodeMap and clusterName == thisClusterName) or (hasNodeMap == false)\n    | join kind=leftouter (nodeMap | project nodeShort, nmCluster=clusterName) on nodeShort\n    | where hasNodeMap == false or nmCluster == thisClusterName\n    | project nodeName);\n\n// Latency only exists in Perf (ReadLatencyMs absent from InsightsMetrics)\nlet perfSamples = Perf\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where (ObjectName == \"Cluster CSVFS\" and CounterName in (\"Avg. sec/Read\", \"Avg. sec/Write\")) or (ObjectName == \"LogicalDisk\" and CounterName in (\"Avg. Disk sec/Read\", \"Avg. Disk sec/Write\"))\r\n| where InstanceName !~ \"_Total\" and InstanceName !startswith \"HarddiskVolume\"\r\n| where isnotnull(CounterValue) and CounterValue >= 0\r\n| extend nodeName = tolower(Computer)\r\n| extend StorageScope = iff(ObjectName == \"Cluster CSVFS\", \"CSV\", \"Logical disks\")\r\n| summarize arg_max(TimeGenerated, CounterValue) by nodeName, InstanceName, CounterName, StorageScope, Minute = bin(TimeGenerated, 1m)\r\n| summarize Directions = dcount(CounterName), LatencyMs = avg(CounterValue) * 1000.0 by nodeName, InstanceName, StorageScope, Minute\r\n| where Directions == 2\r\n| project TimeGenerated = Minute, nodeName, InstanceName, StorageScope, LatencyMs, method = 1;\r\nlet volumeSamples = perfSamples\r\n| lookup kind=inner NodeToCluster on nodeName\r\n| where nodeName == tolower('{SCStorageDetailMachine}') and StorageScope == 'CSV'\r\n| summarize arg_min(method, LatencyMs) by nodeName, InstanceName, StorageScope, TimeGenerated;\r\nvolumeSamples\r\n| summarize [\"Avg Latency (ms)\"] = round(avg(LatencyMs), 2) by TimeGenerated = bin(TimeGenerated, step), Volume = InstanceName\r\n| order by TimeGenerated asc, Volume asc",
              "size": 0,
              "showAnalytics": true,
              "aggregation": 3,
              "title": "Cluster Shared Volumes - Latency (ms) - {SCStorageDetailMachine:label}",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{MachinesLogAnalyticsWorkspace}"
              ],
              "visualization": "linechart",
              "chartSettings": {
                "xAxis": "TimeGenerated",
                "yAxis": [
                  "Avg Latency (ms)"
                ],
                "group": "Volume",
                "createOtherGroup": null,
                "ySettings": {
                  "numberFormatSettings": {
                    "unit": 0,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 2
                    }
                  },
                  "min": 0
                },
                "showLegend": true
              },
              "noDataMessage": "No complete per-volume CSV samples for the selected machine. Verify paired Cluster CSVFS read/write counters in the DCR setup guide.",
              "noDataMessageStyle": 4,
              "timeContextFromParameter": "NodeTrendsTimeRange"
            },
            "customWidth": "50",
            "name": "sc-storage-detail-latency",
            "styleSettings": {
              "margin": "5px",
              "padding": "5px"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let trendStart = {NodeTrendsTimeRange:start};\nlet trendEnd = {NodeTrendsTimeRange:end};\nlet step = 1d;\n\n// Build authoritative NodeToCluster mapping from ARG (Heartbeat + ClusterRGMap + ClusterNodeMap) — no SDDC dependency\nlet clusterMap = materialize(\n    print mapping = parse_json('{ClusterRGMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeRG = tolower(tostring(parts[0])), clusterName = tostring(parts[1]));\nlet nodeMap = materialize(\n    print mapping = parse_json('{ClusterNodeMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeShort = tolower(tostring(parts[0])), clusterName = tostring(parts[1]), armId = tostring(parts[2]));\nlet thisClusterName = toscalar(nodeMap | where armId =~ '{SingleCluster}' | distinct clusterName | project clusterName);\nlet hasNodeMap = isnotempty(thisClusterName);\nlet NodeToCluster = materialize(\n    Heartbeat\n    | where TimeGenerated between (trendStart .. trendEnd)\n    | where OSType == \"Windows\"\n    | summarize arg_max(TimeGenerated, *) by Computer\n    | extend nodeName = tolower(Computer), nodeRG = tolower(ResourceGroup), nodeShort = tolower(tostring(split(Computer, '.')[0]))\n    | lookup kind=inner clusterMap on nodeRG\n    | where (hasNodeMap and clusterName == thisClusterName) or (hasNodeMap == false)\n    | join kind=leftouter (nodeMap | project nodeShort, nmCluster=clusterName) on nodeShort\n    | where hasNodeMap == false or nmCluster == thisClusterName\n    | project nodeName);\n\nlet perfSamples = Perf\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where (ObjectName == \"Cluster CSVFS\" and CounterName in (\"Reads/sec\", \"Writes/sec\")) or (ObjectName == \"LogicalDisk\" and CounterName == \"Disk Transfers/sec\")\r\n| where InstanceName !~ \"_Total\" and InstanceName !startswith \"HarddiskVolume\"\r\n| where isnotnull(CounterValue) and CounterValue >= 0\r\n| extend nodeName = tolower(Computer)\r\n| extend StorageScope = iff(ObjectName == \"Cluster CSVFS\", \"CSV\", \"Logical disks\")\r\n| summarize arg_max(TimeGenerated, CounterValue) by nodeName, InstanceName, CounterName, StorageScope, Minute = bin(TimeGenerated, 1m)\r\n| summarize Directions = dcount(CounterName), IOPS = sum(CounterValue) by nodeName, InstanceName, StorageScope, Minute\r\n| where Directions == iff(StorageScope == \"CSV\", 2, 1)\r\n| project TimeGenerated = Minute, nodeName, InstanceName, StorageScope, IOPS, method = 1;\r\nlet insightsSamples = InsightsMetrics\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where Namespace == \"LogicalDisk\" and Name in (\"ReadsPerSecond\", \"WritesPerSecond\")\r\n| extend nodeName = tolower(tostring(split(_ResourceId, \"/\")[8]))\r\n| extend InstanceName = tostring(parse_json(Tags)[\"vm.azm.ms/mountId\"])\r\n| where isnotempty(InstanceName) and InstanceName !~ \"_Total\" and InstanceName !startswith \"HarddiskVolume\"\r\n| where isnotnull(Val) and Val >= 0\r\n| summarize arg_max(TimeGenerated, Val) by nodeName, InstanceName, Name, Minute = bin(TimeGenerated, 1m)\r\n| summarize Directions = dcount(Name), IOPS = sum(Val) by nodeName, InstanceName, Minute\r\n| where Directions == 2\r\n| project TimeGenerated = Minute, nodeName, InstanceName, StorageScope = \"Logical disks\", IOPS, method = 2;\r\nlet volumeSamples = union perfSamples, insightsSamples\r\n| lookup kind=inner NodeToCluster on nodeName\r\n| where nodeName == tolower('{SCStorageDetailMachine}') and StorageScope == 'CSV'\r\n| summarize arg_min(method, IOPS) by nodeName, InstanceName, StorageScope, TimeGenerated;\r\nvolumeSamples\r\n| summarize [\"Avg IOPS\"] = round(avg(IOPS), 0) by TimeGenerated = bin(TimeGenerated, step), Volume = InstanceName\r\n| order by TimeGenerated asc, Volume asc",
              "size": 0,
              "showAnalytics": true,
              "aggregation": 3,
              "title": "Cluster Shared Volumes - IOPS - {SCStorageDetailMachine:label}",
