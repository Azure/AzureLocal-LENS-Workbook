              "version": "KqlItem/1.0",
              "query": "let trendStart = {NodeTrendsTimeRange:start};\nlet trendEnd = {NodeTrendsTimeRange:end};\nlet step = 1d;\n\n// Build authoritative NodeToCluster mapping from ARG (Heartbeat + ClusterRGMap + ClusterNodeMap) — no SDDC dependency\nlet clusterMap = materialize(\n    print mapping = parse_json('{ClusterRGMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeRG = tolower(tostring(parts[0])), clusterName = tostring(parts[1]));\nlet nodeMap = materialize(\n    print mapping = parse_json('{ClusterNodeMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeShort = tolower(tostring(parts[0])), clusterName = tostring(parts[1]), armId = tostring(parts[2]));\nlet thisClusterName = toscalar(nodeMap | where armId =~ '{SingleCluster}' | distinct clusterName | project clusterName);\nlet hasNodeMap = isnotempty(thisClusterName);\nlet NodeToCluster = materialize(\n    Heartbeat\n    | where TimeGenerated between (trendStart .. trendEnd)\n    | where OSType == \"Windows\"\n    | summarize arg_max(TimeGenerated, *) by Computer\n    | extend nodeName = tolower(Computer), nodeRG = tolower(ResourceGroup), nodeShort = tolower(tostring(split(Computer, '.')[0]))\n    | lookup kind=inner clusterMap on nodeRG\n    | where (hasNodeMap and clusterName == thisClusterName) or (hasNodeMap == false)\n    | join kind=leftouter (nodeMap | project nodeShort, nmCluster=clusterName) on nodeShort\n    | where hasNodeMap == false or nmCluster == thisClusterName\n    | project nodeName);\n\n// Latency only exists in Perf (ReadLatencyMs absent from InsightsMetrics)\nlet perfSamples = Perf\r\n| where TimeGenerated between (trendStart .. trendEnd)\r\n| where (ObjectName == \"Cluster CSVFS\" and CounterName in (\"Avg. sec/Read\", \"Avg. sec/Write\")) or (ObjectName == \"LogicalDisk\" and CounterName in (\"Avg. Disk sec/Read\", \"Avg. Disk sec/Write\"))\r\n| where InstanceName !~ \"_Total\" and InstanceName !startswith \"HarddiskVolume\"\r\n| where isnotnull(CounterValue) and CounterValue >= 0\r\n| extend nodeName = tolower(Computer)\r\n| extend StorageScope = iff(ObjectName == \"Cluster CSVFS\", \"CSV\", \"Logical disks\")\r\n| summarize arg_max(TimeGenerated, CounterValue) by nodeName, InstanceName, CounterName, StorageScope, Minute = bin(TimeGenerated, 1m)\r\n| summarize Directions = dcount(CounterName), LatencyMs = avg(CounterValue) * 1000.0 by nodeName, InstanceName, StorageScope, Minute\r\n| where Directions == 2\r\n| project TimeGenerated = Minute, nodeName, InstanceName, StorageScope, LatencyMs, method = 1;\r\nlet hostSamples = perfSamples\r\n| summarize HostLatencyMs = avg(LatencyMs) by nodeName, TimeGenerated = bin(TimeGenerated, 1m), StorageScope, method\r\n| summarize arg_min(method, HostLatencyMs) by nodeName, TimeGenerated, StorageScope;\r\nlet dailySamples = hostSamples\r\n| lookup kind=inner NodeToCluster on nodeName\r\n| summarize HostLatencyMs = avg(HostLatencyMs) by nodeName, StorageScope, TimeGenerated = bin(TimeGenerated, step);\r\ndailySamples\r\n| where StorageScope == \"Logical disks\"\r\n| summarize [\"Avg Latency (ms)\"] = round(avg(HostLatencyMs), 2) by TimeGenerated, nodeName, StorageScope\r\n| extend Computer = nodeName\r\n| project TimeGenerated, Computer, [\"Avg Latency (ms)\"]\r\n| order by TimeGenerated asc",
