            "name": "sc-vms-table"
          },
          {
            "type": 1,
            "content": {
              "json": "### 🪟 Hyper-V VMs on: {SingleCluster:label}"
            },
            "conditionalVisibility": {
              "parameterName": "ClusterFilter",
              "comparison": "isNotEqualTo",
              "value": "value::all"
            },
            "name": "sc-hyperv-header"
          },
          {
            "type": 1,
            "content": {
              "json": "💡 **Tip:** These charts use the same Hyper-V counters as the **Hyper-V** view, scoped to the Azure Local machines in {SingleCluster:label} and the selected workspace and time range. If telemetry is missing, open **Capacity & Performance > Overview > Show DCR Setup Guide**. Memory Pressure appears only for VMs with Dynamic Memory enabled.",
              "style": "upsell"
            },
            "conditionalVisibility": {
              "parameterName": "ClusterFilter",
              "comparison": "isNotEqualTo",
              "value": "value::all"
            },
            "name": "sc-hyperv-tip"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let trendStart = {NodeTrendsTimeRange:start};\nlet trendEnd = {NodeTrendsTimeRange:end};\nlet clusterMap = materialize(\n    print mapping = parse_json('{ClusterRGMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeRG = tolower(tostring(parts[0])), clusterName = tostring(parts[1]));\nlet nodeMap = materialize(\n    print mapping = parse_json('{ClusterNodeMap}')\n    | mv-expand mapping to typeof(string)\n    | extend parts = split(mapping, ':')\n    | project nodeShort = tolower(tostring(parts[0])), clusterName = tostring(parts[1]), armId = tostring(parts[2]));\nlet thisClusterName = toscalar(nodeMap | where armId =~ '{SingleCluster}' | distinct clusterName | project clusterName);\nlet hasNodeMap = isnotempty(thisClusterName);\nlet clusterHosts = toscalar(\n    Heartbeat\n    | where TimeGenerated > ago(1d)\n    | where OSType == \"Windows\"\n    | summarize arg_max(TimeGenerated, *) by Computer\n    | extend nodeName = tolower(Computer), nodeRG = tolower(ResourceGroup), nodeShort = tolower(tostring(split(Computer, '.')[0]))\n    | lookup kind=inner clusterMap on nodeRG\n    | where (hasNodeMap and clusterName == thisClusterName) or (hasNodeMap == false)\n    | join kind=leftouter (nodeMap | project nodeShort, nmCluster=clusterName) on nodeShort\n    | where hasNodeMap == false or nmCluster == thisClusterName\n    | summarize make_set(nodeName));\nlet perfRaw = Perf\n    | where TimeGenerated between (trendStart .. trendEnd)\n    | where set_has_element(clusterHosts, tolower(Computer))\n    | where ObjectName == \"Hyper-V Hypervisor Virtual Processor\" and CounterName == \"% Guest Run Time\"\n    | extend VMName = tostring(split(InstanceName, \":\")[0])\n    | extend vCpuId = tostring(split(InstanceName, \":\")[1])\n    | where isnotempty(VMName) and VMName != \"_Total\";\nlet cpuStats = perfRaw\n    | where vCpuId != \"_Total\" and isnotempty(vCpuId)\n    | summarize VMcpu = avg(CounterValue) by VMName, bin(TimeGenerated, 1m)\n    | summarize ['Avg CPU %'] = round(avg(VMcpu), 1) by VMName;\nlet memStats = Perf\n    | where TimeGenerated between (trendStart .. trendEnd)\n    | where set_has_element(clusterHosts, tolower(Computer))\n    | where ObjectName == \"Hyper-V Dynamic Memory VM\" and CounterName == \"Current Pressure\"\n    | where InstanceName != \"_Total\" and isnotempty(InstanceName)\n    | summarize ['Avg Memory %'] = round(avg(CounterValue), 1) by VMName = InstanceName;\nperfRaw\n| summarize\n    ['First Seen (UTC)'] = min(TimeGenerated),\n    ['vCPUs (observed)'] = dcountif(vCpuId, vCpuId != \"_Total\" and isnotempty(vCpuId)),\n    arg_max(TimeGenerated, Computer)\n  by VMName\n| project-rename ['Last Seen (UTC)'] = TimeGenerated, ['Physical Host'] = Computer\n| join kind=leftouter cpuStats on VMName\n| project-away VMName1\n| join kind=leftouter memStats on VMName\n| project-away VMName1\n| extend AgeMinutes = datetime_diff('minute', now(), ['Last Seen (UTC)'])\n| extend Activity = case(\n      AgeMinutes <= 15, \"\\u2705 Active (last 15 min)\",\n      AgeMinutes <= 60, \"\\ud83d\\udfe2 Active (last hour)\",\n      AgeMinutes <= 1440, \"\\ud83d\\udfe1 Idle (>1h)\",\n      \"\\ud83d\\udd34 Stale (>24h)\")\n| project ['VM Name'] = VMName, Activity, ['Physical Host'], ['vCPUs (observed)'], ['Avg CPU %'], ['Avg Memory %'], ['First Seen (UTC)'], ['Last Seen (UTC)']\n| order by ['Avg CPU %'] desc nulls last",
              "size": 0,
              "showAnalytics": true,
              "showExportToExcel": true,
              "timeContextFromParameter": "NodeTrendsTimeRange",
              "title": "📋 Hyper-V VM Inventory (Perf-derived) — on {SingleCluster:label}",
              "noDataMessage": "No Hyper-V CPU telemetry was returned for this instance and time range. Open **Capacity & Performance > Overview > Show DCR Setup Guide** to verify the required counter is collected from every machine.",
              "noDataMessageStyle": 4,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{MachinesLogAnalyticsWorkspace}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "VM Name",
                    "formatter": 1
                  },
                  {
                    "columnMatch": "Activity",
                    "formatter": 1
                  },
                  {
                    "columnMatch": "Physical Host",
                    "formatter": 1,
                    "tooltipFormat": {
                      "tooltip": "Physical Machine is the last reporting Azure Local machine in the selected time range. A migrated VM appears once, on its last reporting machine."
                    }
                  },
                  {
                    "columnMatch": "vCPUs (observed)",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": null,
                          "text": "{0}{1}"
                        }
                      ]
                    },
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 0
                      }
                    }
                  },
                  {
                    "columnMatch": "Avg CPU %",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        {
                          "operator": ">=",
                          "thresholdValue": "90",
                          "representation": "4",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": ">=",
                          "thresholdValue": "80",
                          "representation": "2",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "success",
                          "text": "{0}{1}"
                        }
                      ]
                    },
                    "numberFormat": {
                      "unit": 1,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 1
                      }
                    }
                  },
                  {
                    "columnMatch": "Avg Memory %",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        {
                          "operator": ">=",
                          "thresholdValue": "100",
                          "representation": "4",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": ">=",
                          "thresholdValue": "80",
                          "representation": "2",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "success",
                          "text": "{0}{1}"
                        }
                      ]
                    },
                    "numberFormat": {
                      "unit": 1,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 1
                      }
                    }
                  },
                  {
                    "columnMatch": "First Seen (UTC)",
                    "formatter": 6,
                    "dateFormat": {
                      "showUtcTime": true,
                      "formatName": "shortDateTimePattern"
                    }
                  },
                  {
                    "columnMatch": "Last Seen (UTC)",
                    "formatter": 6,
                    "dateFormat": {
                      "showUtcTime": true,
                      "formatName": "shortDateTimePattern"
                    }
                  }
                ],
                "labelSettings": [
                  {
                    "columnId": "Physical Host",
                    "label": "Physical Machine"
                  }
                ],
                "rowLimit": 5000,
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "Avg CPU %",
                    "sortOrder": 2
                  }
                ]
              },
              "sortBy": [
                {
                  "itemKey": "Avg CPU %",
                  "sortOrder": 2
                }
              ]
            },
            "conditionalVisibility": {
              "parameterName": "ClusterFilter",
              "comparison": "isNotEqualTo",
              "value": "value::all"
            },
            "name": "sc-hyperv-inventory"
          },
          {
            "type": 1,
            "content": {
              "json": "## Hyper-V - Virtual Machine and Virtual Disk Performance\n\nCPU, Dynamic Memory pressure and network charts show VM activity on the selected instance. The three storage charts show individual VM virtual disks (VHD/VHDX), not Cluster Shared Volumes, logical disks or physical disks."
            },
            "customWidth": "100",
            "conditionalVisibility": {
              "parameterName": "ClusterFilter",
              "comparison": "isNotEqualTo",
              "value": "value::all"
            },
            "name": "sc-hyperv-performance-header"
          },
          {
            "type": 11,
            "content": {
              "version": "LinkItem/1.0",
              "style": "toolbar",
              "links": [
                {
                  "cellValue": "https://github.com/Azure/AzureLocal-LENS-Workbook/blob/main/example-dcr-template/README.md",
                  "linkTarget": "Url",
                  "linkLabel": "CPU",
                  "postText": "Average % Guest Run Time across each VM's virtual processors, not physical-machine CPU utilization. The five highest VM averages over the selected range are shown.",
                  "icon": "Info",
                  "style": "link"
                },
                {
                  "cellValue": "https://github.com/Azure/AzureLocal-LENS-Workbook/blob/main/example-dcr-template/README.md",
                  "linkTarget": "Url",
                  "linkLabel": "Memory pressure",
                  "postText": "Hyper-V Dynamic Memory VM Current Pressure, not host Memory Used %. A value of 100 indicates demand at the assigned-memory limit; values above 100 indicate pressure. Static-memory VMs do not report this counter.",
                  "icon": "Info",
                  "style": "link"
                },
                {
                  "cellValue": "https://github.com/Azure/AzureLocal-LENS-Workbook/blob/main/example-dcr-template/README.md",
                  "linkTarget": "Url",
                  "linkLabel": "Virtual-disk throughput",
                  "postText": "Hyper-V Virtual Storage Device read and write byte-rate samples, combined per displayed time bin and divided by 1048576. Series use virtual-disk filenames such as VHD/VHDX; identical filenames are combined. Not CSV or physical-disk throughput.",
                  "icon": "Info",
                  "style": "link"
                },
                {
                  "cellValue": "https://github.com/Azure/AzureLocal-LENS-Workbook/blob/main/example-dcr-template/README.md",
                  "linkTarget": "Url",
                  "linkLabel": "Virtual-disk IOPS",
                  "postText": "Hyper-V Virtual Storage Device read and write operations-per-second samples, combined per displayed time bin. Series use virtual-disk filenames; identical filenames are combined. The top five series are selected over the full range, independently of the other charts.",
                  "icon": "Info",
                  "style": "link"
                },
                {
                  "cellValue": "https://github.com/Azure/AzureLocal-LENS-Workbook/blob/main/example-dcr-template/README.md",
                  "linkTarget": "Url",
                  "linkLabel": "Virtual-disk latency",
                  "postText": "Average of collected Hyper-V Virtual Storage Device latency counters, grouped by virtual-disk filename. Identical filenames are combined. This is VM virtual-disk latency, not CSV or logical-disk latency; the five highest selected-range averages are shown.",
                  "icon": "Info",
                  "style": "link"
                },
                {
                  "cellValue": "https://github.com/Azure/AzureLocal-LENS-Workbook/blob/main/example-dcr-template/README.md",
                  "linkTarget": "Url",
                  "linkLabel": "Network",
                  "postText": "Collected Hyper-V Virtual Network Adapter byte-rate samples, combined by VM per displayed time bin and divided by 1048576. This is VM virtual-adapter activity, not physical-machine NIC throughput. The top five VM series are shown.",
                  "icon": "Info",
                  "style": "link"
                }
              ]
            },
            "customWidth": "100",
            "conditionalVisibility": {
              "parameterName": "ClusterFilter",
              "comparison": "isNotEqualTo",
              "value": "value::all"
